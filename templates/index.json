    "custom_liquid_fimeMP": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "subheading": "",
        "title": "",
        "liquid": "{%- comment -%} MOTORTECH — HOMEPAGE (white theme · full width) {%- endcomment -%}\n{%- assign logo_url = \"https://cdn.shopify.com/s/files/1/0752/5403/8702/files/image_2026-06-05_005144225.png?v=1780613508\" -%}\n{%- assign names  = \"Scratch Eraser,Coming Soon,Coming Soon,Coming Soon\" | split: \",\" -%}\n{%- assign blurbs = \"Erase light scratches & swirl marks from your paintwork in minutes.|New automotive upgrade landing soon.|New automotive upgrade landing soon.|New automotive upgrade landing soon.\" | split: \"|\" -%}\n{%- assign hero = collections.all.products.first -%}\n\n<style>\n  #mt-home{--bg:#FFFFFF;--alt:#F4F7FA;--accent:#1E93CF;--accent2:#1681B8;--ink:#0F1620;--text:#566472;--border:#E4E9EF;--foot:#0B0D11;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.6;background:var(--bg);}\n  #mt-home *{box-sizing:border-box;}\n  #mt-home img{max-width:100%;display:block;}\n  #mt-home .wrap{max-width:100%;margin:0 auto;padding:0 24px;}\n  #mt-home .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--accent);color:#fff;font-weight:800;font-size:16px;border:none;border-radius:8px;padding:14px 30px;cursor:pointer;text-decoration:none;box-shadow:0 8px 24px rgba(30,147,207,.28);transition:transform .15s,box-shadow .15s;}\n  #mt-home .btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(30,147,207,.42);}\n  #mt-home .h2{font-size:32px;font-weight:800;text-align:center;margin:0 0 8px;color:var(--ink);text-transform:uppercase;letter-spacing:.5px;}\n  #mt-home .lead{text-align:center;color:var(--text);max-width:620px;margin:0 auto 36px;}\n  #mt-home .sect{padding:56px 0;}\n  #mt-home .alt{background:var(--alt);}\n  #mt-home .ann{background:var(--accent);color:#fff;overflow:hidden;}\n  #mt-home .ann-track{display:flex;gap:60px;white-space:nowrap;padding:10px 0;animation:mt-ann 25s linear infinite;}\n  #mt-home .ann:hover .ann-track{animation-play-state:paused;}\n  #mt-home .ann span{font-size:13px;font-weight:600;letter-spacing:.4px;}\n  @keyframes mt-ann{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n  #mt-home .hdr{background:#fff;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:40;}\n  #mt-home .hdr-in{display:flex;align-items:center;justify-content:space-between;padding:12px 24px;max-width:100%;margin:0 auto;}\n  #mt-home .hdr-logo{font-size:24px;font-weight:900;color:var(--ink);text-decoration:none;letter-spacing:1px;text-transform:uppercase;display:flex;align-items:center;}\n  #mt-home .hdr-logo span{color:var(--accent);}\n  #mt-home .hdr-logo img{height:56px;width:auto;display:block;}\n  #mt-home .hdr-nav{display:flex;gap:26px;}\n  #mt-home .hdr-nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px;}\n  #mt-home .hdr-nav a:hover{color:var(--accent);}\n  #mt-home .hdr-act{display:flex;align-items:center;gap:18px;}\n  #mt-home .hdr-act a,#mt-home .hdr-act button{background:none;border:none;cursor:pointer;color:var(--ink);text-decoration:none;display:flex;padding:0;}\n  #mt-home .hdr-act svg{width:22px;height:22px;}\n  #mt-home .hdr-cart{position:relative;}\n  #mt-home .hdr-count{position:absolute;top:-8px;right:-10px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;}\n  @media(max-width:760px){#mt-home .hdr-nav{display:none;}}\n  #mt-home .ss{position:relative;overflow:hidden;}\n  #mt-home .ss-track{display:flex;transition:transform .6s ease;}\n  #mt-home .ss-slide{min-width:100%;position:relative;}\n  #mt-home .ss-slide img{width:100%;height:560px;object-fit:cover;}\n  #mt-home .ss-ph{width:100%;height:560px;background:radial-gradient(circle at 30% 40%,#1f5e7d,#0B0D11 70%);}\n  #mt-home .ss-ph.b{background:radial-gradient(circle at 70% 50%,#1a4f6a,#0B0D11 70%);}\n  #mt-home .ss-ov{position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,8,11,.72),rgba(6,8,11,.2));}\n  #mt-home .ss-content{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;max-width:100%;margin:0 auto;padding:0 48px;color:#fff;}\n  #mt-home .ss-content .eyebrow{font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8FD3F2;margin-bottom:10px;}\n  #mt-home .ss-content h2{font-size:clamp(30px,5vw,54px);font-weight:900;line-height:1.05;margin:0 0 12px;max-width:620px;text-transform:uppercase;color:#fff;}\n  #mt-home .ss-content p{font-size:clamp(15px,2vw,20px);margin:0 0 22px;max-width:520px;color:#E7EEF3;}\n  #mt-home .ss-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.85);border:none;color:var(--accent);width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:22px;display:flex;align-items:center;justify-content:center;}\n  #mt-home .ss-prev{left:16px;}#mt-home .ss-next{right:16px;}\n  #mt-home .ss-dots{position:absolute;bottom:18px;left:0;right:0;display:flex;justify-content:center;gap:8px;}\n  #mt-home .ss-dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.5);border:none;cursor:pointer;padding:0;}\n  #mt-home .ss-dot.active{background:#fff;width:24px;border-radius:5px;}\n  @media(max-width:760px){#mt-home .ss-slide img,#mt-home .ss-ph{height:460px;}#mt-home .ss-content{text-align:center;align-items:center;padding:0 24px;}#mt-home .ss-content p{margin-inline:auto;}#mt-home .ss-nav{display:none;}}\n  #mt-home .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}\n  #mt-home .grid a.card{text-decoration:none;color:var(--ink);}\n  #mt-home .card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#fff;transition:transform .15s,box-shadow .15s,border-color .15s;display:flex;flex-direction:column;}\n  #mt-home .card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(15,22,32,.12);border-color:var(--accent);}\n  #mt-home .card .ph{width:100%;aspect-ratio:1/1;background:linear-gradient(135deg,#E6F4FB,#cfe7f4);display:flex;align-items:center;justify-content:center;font-size:46px;}\n  #mt-home .card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#fff;}\n  #mt-home .card .body{padding:16px;display:flex;flex-direction:column;flex:1;}\n  #mt-home .card .nm{font-weight:800;font-size:16px;margin:0 0 4px;color:var(--ink);}\n  #mt-home .card .bl{font-size:13px;color:var(--text);margin:0 0 12px;flex:1;}\n  #mt-home .card .pr{color:var(--accent);font-weight:800;font-size:16px;margin-bottom:12px;}\n  #mt-home .card .go{display:block;text-align:center;background:var(--accent);color:#fff;border-radius:8px;padding:11px;font-weight:800;font-size:14px;text-decoration:none;}\n  @media(max-width:980px){#mt-home .grid{grid-template-columns:1fr 1fr;}}\n  @media(max-width:460px){#mt-home .grid{grid-template-columns:1fr;}}\n  #mt-home .fp{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}\n  #mt-home .fp img,#mt-home .fp .ph{width:100%;border-radius:16px;background:#fff;aspect-ratio:1/1;object-fit:cover;}\n  #mt-home .fp .ph{background:linear-gradient(135deg,#E6F4FB,#cfe7f4);display:flex;align-items:center;justify-content:center;font-size:64px;}\n  #mt-home .fp .eyebrow{color:var(--accent);font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;}\n  #mt-home .fp h2{font-size:32px;font-weight:800;text-align:left;margin:8px 0 12px;text-transform:uppercase;color:var(--ink);}\n  #mt-home .fp p{color:var(--text);font-size:16px;margin:0 0 16px;}\n  #mt-home .fp .price{font-size:26px;font-weight:800;color:var(--accent);}\n  #mt-home .feat{list-style:none;padding:0;margin:0 0 18px;}\n  #mt-home .feat li{display:flex;gap:10px;margin-bottom:9px;font-size:15px;color:var(--ink);}\n  #mt-home .feat .ck{color:var(--accent);font-weight:800;}\n  @media(max-width:760px){#mt-home .fp{grid-template-columns:1fr;gap:24px;}#mt-home .fp h2{text-align:center;}}\n  #mt-home .band{text-align:center;background:radial-gradient(circle at 50% 0%,#E9F6FC,#fff 65%);}\n  #mt-home .band .eyebrow{color:var(--accent);font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;}\n  #mt-home .band h2{font-size:34px;margin:10px 0 16px;text-transform:uppercase;color:var(--ink);}\n  #mt-home .band p{color:var(--text);font-size:17px;max-width:660px;margin:0 auto;}\n  #mt-home .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}\n  #mt-home .trust .ti{text-align:center;}\n  #mt-home .trust .ti .ico{width:58px;height:58px;border-radius:50%;background:#E9F6FC;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:26px;}\n  #mt-home .trust .ti h3{font-size:16px;margin:0 0 4px;color:var(--ink);}\n  #mt-home .trust .ti p{font-size:13px;color:var(--text);margin:0;}\n  @media(max-width:760px){#mt-home .trust{grid-template-columns:1fr 1fr;}}\n  #mt-home .ft{background:var(--foot);color:#F4ECD6;padding:54px 0 0;}\n  #mt-home .ft a{color:#fff;text-decoration:none;opacity:.8;}#mt-home .ft a:hover{opacity:1;color:#8FD3F2;}\n  #mt-home .ft-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:40px;}\n  #mt-home .ft .name{font-size:22px;font-weight:900;text-transform:uppercase;letter-spacing:1px;color:#fff;}\n  #mt-home .ft .name span{color:var(--accent);}\n  #mt-home .ft p.tag{opacity:.8;font-size:14px;max-width:280px;color:#A7B0BD;}\n  #mt-home .ft h4{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin:0 0 14px;color:#fff;}\n  #mt-home .ft ul{list-style:none;padding:0;margin:0;}#mt-home .ft li{margin-bottom:10px;font-size:14px;}\n  #mt-home .ft .news input{padding:11px 14px;border:1px solid #2a313b;background:#14171d;color:#fff;border-radius:8px;font-size:14px;width:100%;margin-bottom:8px;}\n  #mt-home .ft .news button{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:11px 18px;font-weight:800;cursor:pointer;width:100%;}\n  #mt-home .ft-bottom{border-top:1px solid rgba(255,255,255,.15);padding:20px 0;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center;}\n  #mt-home .ft-bottom p{margin:0;font-size:13px;opacity:.6;color:#A7B0BD;}\n  #mt-home .ft-cod span{background:rgba(255,255,255,.1);border-radius:5px;padding:4px 10px;font-size:12px;font-weight:700;}\n  @media(max-width:760px){#mt-home .ft-grid{grid-template-columns:1fr 1fr;}}\n  #mt-home .cd-ov{position:fixed;inset:0;background:rgba(15,22,32,.45);z-index:9990;opacity:0;visibility:hidden;transition:opacity .25s;}\n  #mt-home .cd-ov.open{opacity:1;visibility:visible;}\n  #mt-home .cd{position:fixed;top:0;right:0;bottom:0;width:400px;max-width:90vw;background:#fff;z-index:9991;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s;border-left:1px solid var(--border);}\n  #mt-home .cd.open{transform:translateX(0);}\n  #mt-home .cd-head{display:flex;align-items:center;justify-content:space-between;padding:20px;border-bottom:1px solid var(--border);}\n  #mt-home .cd-head h3{margin:0;font-size:18px;font-weight:800;color:var(--ink);text-transform:uppercase;}\n  #mt-home .cd-close{background:none;border:none;font-size:26px;cursor:pointer;color:var(--ink);}\n  #mt-home .cd-items{flex:1;overflow-y:auto;padding:16px 20px;}\n  #mt-home .cd-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);}\n  #mt-home .cd-item img{width:62px;height:62px;object-fit:cover;border-radius:10px;background:var(--alt);}\n  #mt-home .cd-title{font-weight:700;font-size:14px;color:var(--ink);text-decoration:none;}\n  #mt-home .cd-qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:8px;margin-top:6px;}\n  #mt-home .cd-qty button{width:28px;height:28px;border:none;background:none;cursor:pointer;font-size:16px;color:var(--ink);}\n  #mt-home .cd-qty span{width:30px;text-align:center;font-size:13px;font-weight:700;color:var(--ink);}\n  #mt-home .cd-rm{background:none;border:none;color:#94A3B8;font-size:12px;cursor:pointer;text-decoration:underline;padding:0;margin-top:4px;}\n  #mt-home .cd-foot{padding:20px;border-top:1px solid var(--border);}\n  #mt-home .cd-sub{display:flex;justify-content:space-between;font-weight:800;font-size:16px;margin-bottom:6px;color:var(--ink);}\n  #mt-home .cd-co{display:block;text-align:center;background:var(--accent);color:#fff;border-radius:8px;padding:15px;font-weight:800;text-decoration:none;}\n  #mt-home .cd-empty{text-align:center;color:#94A3B8;padding:60px 20px;}\n</style>\n\n<div id=\"mt-home\">\n  <div class=\"ann\"><div class=\"ann-track\">\n    {%- for i in (1..2) -%}\n      <span>🔧 Premium automotive tech &amp; accessories</span><span>🚚 FREE delivery on every order</span><span>💵 Cash on Delivery available</span><span>⭐ Built for drivers who care</span>\n    {%- endfor -%}\n  </div></div>\n\n  <header class=\"hdr\"><div class=\"hdr-in\">\n    <a class=\"hdr-logo\" href=\"{{ routes.root_url }}\">{%- if logo_url != blank -%}<img src=\"{{ logo_url }}\" alt=\"MotorTech\">{%- elsif shop.brand.logo -%}<img src=\"{{ shop.brand.logo | image_url: width: 300 }}\" alt=\"{{ shop.name | escape }}\">{%- else -%}Motor<span>Tech</span>{%- endif -%}</a>\n    <nav class=\"hdr-nav\">\n      <a href=\"{{ routes.root_url }}\">Home</a>\n      <a href=\"{{ routes.all_products_collection_url }}\">Shop</a>\n      <a href=\"/pages/about\">About</a>\n      <a href=\"/pages/contact\">Contact</a>\n    </nav>\n    <div class=\"hdr-act\">\n      <a href=\"{{ routes.search_url }}\" aria-label=\"Search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></a>\n      <a href=\"{{ routes.account_url }}\" aria-label=\"Login\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-6 8-6s8 2 8 6\"/></svg></a>\n      <button class=\"hdr-cart\" onclick=\"mtCartOpen()\" aria-label=\"Cart\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg><span class=\"hdr-count\" id=\"mt-count\">{{ cart.item_count }}</span></button>\n    </div>\n  </div></header>\n\n  <section class=\"ss\"><div class=\"ss-track\" id=\"mt-ss-track\">\n    <div class=\"ss-slide\">\n      {%- if hero.featured_image -%}<img src=\"{{ hero.featured_image | image_url: width: 2000 }}\" alt=\"\">{%- else -%}<div class=\"ss-ph\"></div>{%- endif -%}\n      <div class=\"ss-ov\"></div>\n      <div class=\"ss-content\"><div class=\"eyebrow\">Automotive Tech &amp; Accessories</div><h2>Upgrade Your Drive</h2><p>Smart, reliable car upgrades that make every drive better — delivered to your door.</p><a class=\"btn\" href=\"{{ routes.all_products_collection_url }}\">Shop All Products</a></div>\n    </div>\n    <div class=\"ss-slide\">\n      {%- if hero.images[1] -%}<img src=\"{{ hero.images[1] | image_url: width: 2000 }}\" alt=\"\">{%- else -%}<div class=\"ss-ph b\"></div>{%- endif -%}\n      <div class=\"ss-ov\"></div>\n      <div class=\"ss-content\"><div class=\"eyebrow\">No Risk, No Hassle</div><h2>Free Delivery + Cash on Delivery</h2><p>Pay only when it arrives. Quality-tested accessories, shipped fast.</p><a class=\"btn\" href=\"{{ routes.all_products_collection_url }}\">Discover More</a></div>\n    </div>\n  </div>\n    <button class=\"ss-nav ss-prev\" onclick=\"mtSlide(-1)\" aria-label=\"Prev\">‹</button>\n    <button class=\"ss-nav ss-next\" onclick=\"mtSlide(1)\" aria-label=\"Next\">›</button>\n    <div class=\"ss-dots\"><button class=\"ss-dot active\" onclick=\"mtGoto(0)\"></button><button class=\"ss-dot\" onclick=\"mtGoto(1)\"></button></div>\n  </section>\n\n  <section class=\"sect\"><div class=\"wrap\">\n    <h2 class=\"h2\">Our Products</h2>\n    <p class=\"lead\">Carefully selected automotive tech &amp; accessories — built to perform and easy to use.</p>\n    <div class=\"grid\">\n      {%- assign storeprods = collections.all.products -%}\n      {%- if storeprods.size > 0 -%}\n        {%- for prod in storeprods limit: 8 -%}\n          <a class=\"card\" href=\"{{ prod.url }}\">\n            {%- if prod.featured_image -%}\n              <img src=\"{{ prod.featured_image | image_url: width: 500 }}\" alt=\"{{ prod.title | escape }}\">\n            {%- else -%}\n              <div class=\"ph\">🚗</div>\n            {%- endif -%}\n            <div class=\"body\">\n              <h3 class=\"nm\">{{ prod.title }}</h3>\n              <p class=\"bl\">{{ prod.description | strip_html | truncatewords: 16 }}</p>\n              <div class=\"pr\">{{ prod.price | money }}</div>\n              <span class=\"go\">Shop Now</span>\n            </div>\n          </a>\n        {%- endfor -%}\n      {%- else -%}\n        {%- for nm in names -%}\n          {%- assign bl = blurbs[forloop.index0] -%}\n          <div class=\"card\">\n            <div class=\"ph\">🚗</div>\n            <div class=\"body\">\n              <h3 class=\"nm\">{{ nm }}</h3>\n              <p class=\"bl\">{{ bl }}</p>\n              <a class=\"go\" href=\"{{ routes.all_products_collection_url }}\" style=\"margin-top:auto;\">Coming Soon</a>\n            </div>\n          </div>\n        {%- endfor -%}\n      {%- endif -%}\n    </div>\n  </div></section>\n\n  <section class=\"sect alt\"><div class=\"wrap\"><div class=\"fp\">\n    <div>{%- if hero.featured_image -%}<img src=\"{{ hero.featured_image | image_url: width: 800 }}\" alt=\"\">{%- else -%}<div class=\"ph\">🚗</div>{%- endif -%}</div>\n    <div>\n      <span class=\"eyebrow\">Best Seller</span>\n      <h2>{{ hero.title | default: names[0] }}</h2>\n      <ul class=\"feat\">\n        <li><span class=\"ck\">✓</span> Professional-grade results at home</li>\n        <li><span class=\"ck\">✓</span> Easy to use — no special tools needed</li>\n        <li><span class=\"ck\">✓</span> Safe on automotive paint &amp; clear coat</li>\n        <li><span class=\"ck\">✓</span> Free delivery + cash on delivery</li>\n      </ul>\n      {%- if hero -%}<div style=\"margin-bottom:16px;\"><span class=\"price\">{{ hero.price | money }}</span></div>{%- endif -%}\n      <a class=\"btn\" href=\"{{ hero.url | default: routes.all_products_collection_url }}\">Shop Now</a>\n    </div>\n  </div></div></section>\n\n  <section class=\"sect band\"><div class=\"wrap\">\n    <span class=\"eyebrow\">The MotorTech Promise</span>\n    <h2>Built for Drivers Who Care</h2>\n    <p>We hand-pick automotive tech and accessories that actually deliver — tested for quality, easy to use, and priced fair. No gimmicks, just upgrades that make owning your car better.</p>\n  </div></section>\n\n  <section class=\"sect alt\"><div class=\"wrap\"><div class=\"trust\">\n    <div class=\"ti\"><div class=\"ico\">🛡️</div><h3>Quality Tested</h3><p>Vetted for real-world performance.</p></div>\n    <div class=\"ti\"><div class=\"ico\">🚚</div><h3>Free Delivery</h3><p>On every order, no minimum.</p></div>\n    <div class=\"ti\"><div class=\"ico\">💵</div><h3>Cash on Delivery</h3><p>Pay when it arrives.</p></div>\n    <div class=\"ti\"><div class=\"ico\">💬</div><h3>Friendly Support</h3><p>We reply within 24 hours.</p></div>\n  </div></div></section>\n\n  <footer class=\"ft\"><div class=\"wrap\">\n    <div class=\"ft-grid\">\n      <div><div class=\"name\">Motor<span>Tech</span></div><p class=\"tag\">Automotive tech &amp; accessories for drivers who care. Upgrade your drive.</p></div>\n      <div><h4>Shop</h4><ul>\n        {%- assign ftprods = collections.all.products -%}\n        {%- if ftprods.size > 0 -%}\n          {%- for prod in ftprods limit: 6 -%}\n            <li><a href=\"{{ prod.url }}\">{{ prod.title }}</a></li>\n          {%- endfor -%}\n        {%- else -%}\n          <li><a href=\"{{ routes.all_products_collection_url }}\">All Products</a></li>\n        {%- endif -%}\n      </ul></div>\n      <div><h4>Help</h4><ul><li><a href=\"/pages/contact\">Contact</a></li><li><a href=\"/pages/shipping\">Shipping</a></li><li><a href=\"/pages/returns\">Returns</a></li></ul></div>\n      <div class=\"news\"><h4>Stay in touch</h4>\n        {%- form 'customer' -%}<input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,footer\"><input type=\"email\" name=\"contact[email]\" placeholder=\"Your email\" required><button type=\"submit\">Subscribe</button>{%- if form.posted_successfully? -%}<p style=\"color:#8FD3F2;margin-top:8px;font-size:13px;\">Subscribed — thank you!</p>{%- endif -%}{%- endform -%}\n      </div>\n    </div>\n    <div class=\"ft-bottom\"><p>© {{ 'now' | date: '%Y' }} MotorTech. All rights reserved.</p><div class=\"ft-cod\"><span>💵 Cash on Delivery</span></div></div>\n  </div></footer>\n\n  <div class=\"cd-ov\" id=\"mt-cd-ov\" onclick=\"mtCartClose()\"></div>\n  <aside class=\"cd\" id=\"mt-cd\" aria-label=\"Cart\">\n    <div class=\"cd-head\"><h3>Your Cart (<span id=\"mt-cd-count\">{{ cart.item_count }}</span>)</h3><button class=\"cd-close\" onclick=\"mtCartClose()\">×</button></div>\n    <div class=\"cd-items\" id=\"mt-cd-items\"></div><div class=\"cd-foot\" id=\"mt-cd-foot\"></div>\n  </aside>\n</div>\n\n<script>\n(function(){\n  function fmt(c){ return \"$\"+(c/100).toFixed(2); }\n  var i=0,n=2,track=document.getElementById(\"mt-ss-track\"),dots=document.querySelectorAll(\"#mt-home .ss-dot\");\n  function go(k){ i=(k+n)%n; track.style.transform=\"translateX(-\"+(i*100)+\"%)\"; dots.forEach(function(d,j){d.classList.toggle(\"active\",j===i);}); }\n  window.mtSlide=function(d){ go(i+d); }; window.mtGoto=function(k){ go(k); };\n  setInterval(function(){ go(i+1); },6000);\n  var ov=document.getElementById(\"mt-cd-ov\"),cd=document.getElementById(\"mt-cd\"),itemsEl=document.getElementById(\"mt-cd-items\"),footEl=document.getElementById(\"mt-cd-foot\");\n  function render(cart){\n    document.getElementById(\"mt-cd-count\").textContent=cart.item_count;\n    var hc=document.getElementById(\"mt-count\"); if(hc) hc.textContent=cart.item_count;\n    if(cart.item_count===0){ itemsEl.innerHTML='<div class=\"cd-empty\"><p>Your cart is empty.</p></div>'; footEl.innerHTML=\"\"; return; }\n    var h=\"\";\n    cart.items.forEach(function(it,i){\n      h+='<div class=\"cd-item\"><img src=\"'+(it.image?it.image.replace(/(\\.[a-z]+)(\\?|$)/i,\"_120x$1$2\"):\"\")+'\" alt=\"\">'\n       +'<div style=\"flex:1\"><a class=\"cd-title\" href=\"'+it.url+'\">'+it.product_title+'</a>'\n       +(it.variant_title?'<div style=\"font-size:12px;color:#94A3B8\">'+it.variant_title+'</div>':'')\n       +'<div class=\"cd-qty\"><button onclick=\"mtCartChange('+(i+1)+','+(it.quantity-1)+')\">−</button><span>'+it.quantity+'</span><button onclick=\"mtCartChange('+(i+1)+','+(it.quantity+1)+')\">+</button></div>'\n       +'<button class=\"cd-rm\" onclick=\"mtCartChange('+(i+1)+',0)\">Remove</button></div>'\n       +'<div style=\"font-weight:700;color:#0F1620\">'+fmt(it.final_line_price)+'</div></div>';\n    });\n    itemsEl.innerHTML=h;\n    footEl.innerHTML='<div class=\"cd-sub\"><span>Subtotal</span><span>'+fmt(cart.total_price)+'</span></div><p style=\"font-size:12px;color:#94A3B8;margin:0 0 14px\">Cash on delivery · taxes at checkout.</p><a class=\"cd-co\" href=\"/checkout\">Checkout</a>';\n  }\n  function refresh(){ fetch(\"/cart.js\").then(function(r){return r.json();}).then(render); }\n  window.mtCartOpen=function(){ ov.classList.add(\"open\"); cd.classList.add(\"open\"); document.body.style.overflow=\"hidden\"; refresh(); };\n  window.mtCartClose=function(){ ov.classList.remove(\"open\"); cd.classList.remove(\"open\"); document.body.style.overflow=\"\"; };\n  window.mtCartChange=function(line,qty){ fetch(\"/cart/change.js\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({line:line,quantity:qty})}).then(function(r){return r.json();}).then(render); };\n  refresh();\n})();\n</script>",
