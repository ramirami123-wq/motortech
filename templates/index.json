    "custom_liquid_fimeMP": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "subheading": "",
        "title": "",
        "liquid": "{%- comment -%} MOTORTECH — PRODUCT PAGE {%- endcomment -%}\n{%- assign logo_url = \"https://cdn.shopify.com/s/files/1/0752/5403/8702/files/image_2026-06-05_005144225.png?v=1780613508\" -%}\n{%- assign p = product -%}\n{%- unless p -%}{%- assign p = all_products.first -%}{%- endunless -%}\n{%- assign cur = p.selected_or_first_available_variant -%}\n\n<style>\n  #mt-pdp{--dark:#0B0D11;--panel:#13161C;--panel2:#191D25;--accent:#29A9DD;--accent2:#1E8FC0;--cream:#F4ECD6;--text:#A7B0BD;--border:#272D36;--gold:#29A9DD;--sale:#29A9DD;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;color:var(--cream);line-height:1.6;background:var(--dark);}\n  #mt-pdp *{box-sizing:border-box;}\n  #mt-pdp img{max-width:100%;display:block;}\n  #mt-pdp .wrap{max-width:1140px;margin:0 auto;padding:0 20px;}\n  #mt-pdp .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--accent);color:#06121A;font-weight:800;font-size:16px;border:none;border-radius:8px;padding:15px 32px;cursor:pointer;text-decoration:none;box-shadow:0 8px 24px rgba(41,169,221,.28);transition:transform .15s,box-shadow .15s;width:100%;}\n  #mt-pdp .btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(41,169,221,.45);}\n  #mt-pdp .btn[disabled]{background:#3a4049;color:#7C8896;box-shadow:none;cursor:not-allowed;}\n  #mt-pdp .stars{color:var(--gold);letter-spacing:2px;}\n  #mt-pdp .h2{font-size:32px;font-weight:800;text-align:center;margin:0 0 8px;color:var(--cream);text-transform:uppercase;letter-spacing:.5px;}\n  #mt-pdp .lead{text-align:center;color:var(--text);max-width:620px;margin:0 auto 36px;}\n  #mt-pdp .sect{padding:56px 0;}\n  #mt-pdp .alt{background:var(--panel);}\n  #mt-pdp .ann{background:#06080B;color:var(--cream);overflow:hidden;border-bottom:1px solid var(--border);}\n  #mt-pdp .ann-track{display:flex;gap:60px;white-space:nowrap;padding:10px 0;animation:mt-ann 25s linear infinite;}\n  #mt-pdp .ann:hover .ann-track{animation-play-state:paused;}\n  #mt-pdp .ann span{font-size:13px;font-weight:600;letter-spacing:.4px;}\n  @keyframes mt-ann{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n  #mt-pdp .hdr{background:rgba(11,13,17,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:40;}\n  #mt-pdp .hdr-in{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1140px;margin:0 auto;}\n  #mt-pdp .hdr-logo{font-size:24px;font-weight:900;color:var(--cream);text-decoration:none;letter-spacing:1px;text-transform:uppercase;display:flex;align-items:center;}\n  #mt-pdp .hdr-logo span{color:var(--accent);}\n  #mt-pdp .hdr-logo img{height:56px;width:auto;display:block;}\n  #mt-pdp .hdr-nav{display:flex;gap:26px;}\n  #mt-pdp .hdr-nav a{color:var(--cream);text-decoration:none;font-weight:600;font-size:15px;}\n  #mt-pdp .hdr-nav a:hover{color:var(--accent);}\n  #mt-pdp .hdr-act{display:flex;align-items:center;gap:18px;}\n  #mt-pdp .hdr-act a,#mt-pdp .hdr-act button{background:none;border:none;cursor:pointer;color:var(--cream);text-decoration:none;display:flex;padding:0;}\n  #mt-pdp .hdr-act svg{width:22px;height:22px;}\n  #mt-pdp .hdr-cart{position:relative;}\n  #mt-pdp .hdr-count{position:absolute;top:-8px;right:-10px;background:var(--accent);color:#06121A;font-size:11px;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;}\n  @media(max-width:760px){#mt-pdp .hdr-nav{display:none;}}\n  #mt-pdp .crumb{font-size:13px;color:#7C8896;padding:16px 0 0;}\n  #mt-pdp .crumb a{color:#7C8896;text-decoration:none;}#mt-pdp .crumb a:hover{color:var(--accent);}\n  #mt-pdp .pc{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:24px 0 56px;align-items:start;}\n  #mt-pdp .gallery .main{border-radius:16px;background:#fff;aspect-ratio:1/1;object-fit:cover;width:100%;}\n  #mt-pdp .thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}\n  #mt-pdp .thumbs img{width:74px;height:74px;object-fit:cover;border-radius:10px;border:2px solid var(--border);cursor:pointer;background:#fff;}\n  #mt-pdp .thumbs img.active{border-color:var(--accent);}\n  #mt-pdp .pc h1{font-size:34px;font-weight:800;margin:6px 0 12px;color:var(--cream);}\n  #mt-pdp .price-row{display:flex;align-items:center;gap:12px;margin-bottom:6px;flex-wrap:wrap;}\n  #mt-pdp .price{font-size:30px;font-weight:800;color:var(--accent);}\n  #mt-pdp .compare{font-size:19px;color:#7C8896;text-decoration:line-through;}\n  #mt-pdp .sale-badge{background:var(--accent);color:#06121A;font-weight:800;font-size:12px;padding:5px 10px;border-radius:6px;letter-spacing:.5px;}\n  #mt-pdp .pc-desc{color:var(--text);font-size:15px;margin:14px 0;}\n  #mt-pdp .brew{display:flex;gap:10px;align-items:flex-start;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:13px 16px;margin:14px 0;font-size:14px;color:var(--text);}\n  #mt-pdp .brew svg{width:20px;height:20px;color:var(--accent);flex:none;margin-top:2px;}\n  #mt-pdp .brew b{color:var(--cream);}\n  #mt-pdp .countdown{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px 16px;text-align:center;margin:16px 0;}\n  #mt-pdp .countdown .cd-label{font-size:13px;font-weight:700;margin-bottom:8px;color:var(--cream);}\n  #mt-pdp .countdown .cd-clock{display:flex;justify-content:center;align-items:center;gap:8px;}\n  #mt-pdp .countdown .cd-unit{background:var(--accent);color:#06121A;border-radius:8px;min-width:54px;padding:8px 6px;}\n  #mt-pdp .countdown .cd-num{font-size:22px;font-weight:800;line-height:1;}\n  #mt-pdp .countdown .cd-cap{font-size:10px;opacity:.8;text-transform:uppercase;letter-spacing:.5px;}\n  #mt-pdp .countdown .cd-sep{font-size:20px;font-weight:800;color:var(--accent);}\n  #mt-pdp .opt{margin:14px 0;}\n  #mt-pdp .opt label{display:block;font-weight:700;font-size:13px;margin-bottom:7px;color:var(--cream);}\n  #mt-pdp .swatches{display:flex;flex-wrap:wrap;gap:8px;}\n  #mt-pdp .swatch{border:2px solid var(--border);border-radius:8px;padding:9px 16px;cursor:pointer;font-weight:600;font-size:14px;background:var(--panel);color:var(--cream);}\n  #mt-pdp .swatch.active{border-color:var(--accent);background:rgba(41,169,221,.15);color:var(--accent);}\n  #mt-pdp .qty{display:inline-flex;align-items:center;border:2px solid var(--border);border-radius:8px;overflow:hidden;}\n  #mt-pdp .qty button{width:42px;height:42px;border:none;background:var(--panel);color:var(--cream);font-size:20px;cursor:pointer;}\n  #mt-pdp .qty input{width:46px;height:42px;text-align:center;border:none;background:var(--panel);color:var(--cream);font-size:16px;font-weight:700;-moz-appearance:textfield;}\n  #mt-pdp .qty input::-webkit-outer-spin-button,#mt-pdp .qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}\n  #mt-pdp .delivery{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-top:14px;}\n  #mt-pdp .delivery svg{width:18px;height:18px;color:var(--accent);flex:none;}\n  #mt-pdp .delivery b{color:var(--cream);}\n  #mt-pdp .pc-badges{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px;}\n  #mt-pdp .pc-badges .b{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--text);}\n  #mt-pdp .pc-badges svg{width:18px;height:18px;color:var(--accent);}\n  @media(max-width:760px){#mt-pdp .pc{grid-template-columns:1fr;gap:24px;}#mt-pdp .pc h1{font-size:28px;}}\n  #mt-pdp .rel{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}\n  #mt-pdp .rel a{text-decoration:none;color:var(--cream);}\n  #mt-pdp .rel .card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--panel2);transition:box-shadow .15s,border-color .15s;}\n  #mt-pdp .rel .card:hover{box-shadow:0 10px 26px rgba(0,0,0,.5);border-color:var(--accent);}\n  #mt-pdp .rel .card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#fff;}\n  #mt-pdp .rel .card .body{padding:12px;}\n  #mt-pdp .rel .card .nm{font-weight:700;font-size:14px;color:var(--cream);}\n  #mt-pdp .rel .card .pr{color:var(--accent);font-weight:800;font-size:14px;margin-top:4px;}\n  @media(max-width:760px){#mt-pdp .rel{grid-template-columns:1fr 1fr;}}\n  #mt-pdp .split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}\n  #mt-pdp .split img,#mt-pdp .split .ph{border-radius:16px;width:100%;aspect-ratio:1/1;object-fit:cover;background:#fff;}\n  #mt-pdp .split .ph{background:radial-gradient(circle at 50% 40%,#1b3a4a,#0e1116);display:flex;align-items:center;justify-content:center;font-size:64px;}\n  #mt-pdp .split h2{text-align:left;font-size:28px;color:var(--cream);text-transform:uppercase;}\n  #mt-pdp .split .eyebrow{color:var(--accent);font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;}\n  #mt-pdp .steps{list-style:none;padding:0;margin:16px 0 0;counter-reset:s;}\n  #mt-pdp .steps li{display:flex;gap:12px;margin-bottom:14px;font-size:15px;align-items:flex-start;color:var(--cream);}\n  #mt-pdp .steps li::before{counter-increment:s;content:counter(s);background:var(--accent);color:#06121A;font-weight:800;font-size:13px;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;}\n  @media(max-width:760px){#mt-pdp .split{grid-template-columns:1fr;gap:24px;}#mt-pdp .split h2{text-align:center;}}\n  #mt-pdp .ben-eyebrow{display:block;text-align:center;color:var(--accent);font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;}\n  #mt-pdp .benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:32px 0 28px;}\n  #mt-pdp .bcard{display:flex;gap:14px;background:var(--panel2);border:1px solid var(--border);border-radius:14px;padding:18px;align-items:flex-start;}\n  #mt-pdp .bcard .bi{width:44px;height:44px;border-radius:50%;background:rgba(41,169,221,.12);display:flex;align-items:center;justify-content:center;font-size:22px;flex:none;}\n  #mt-pdp .bcard h3{margin:0 0 4px;font-size:16px;color:var(--cream);}\n  #mt-pdp .bcard p{margin:0;font-size:14px;color:var(--text);line-height:1.55;}\n  #mt-pdp .prep-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;max-width:900px;margin:0 auto;}\n  #mt-pdp .prep,#mt-pdp .warn{border-radius:14px;padding:18px 20px;font-size:14px;line-height:1.55;}\n  #mt-pdp .prep{background:var(--panel);border:1px solid var(--border);color:var(--text);}\n  #mt-pdp .prep h3{margin:0 0 6px;font-size:15px;color:var(--cream);}\n  #mt-pdp .warn{background:rgba(41,169,221,.07);border:1px solid var(--border);color:var(--text);}\n  #mt-pdp .warn h3{margin:0 0 6px;font-size:15px;color:var(--accent);}\n  @media(max-width:680px){#mt-pdp .benefits{grid-template-columns:1fr;}}\n  #mt-pdp .cmp{max-width:820px;margin:0 auto;}\n  #mt-pdp .cmp-table{width:100%;border-collapse:separate;border-spacing:0;}\n  #mt-pdp .cmp-table th,#mt-pdp .cmp-table td{padding:16px 14px;text-align:center;font-size:14px;}\n  #mt-pdp .cmp-table th:first-child,#mt-pdp .cmp-table td:first-child{text-align:left;font-weight:600;color:var(--cream);}\n  #mt-pdp .cmp-table thead th{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text);}\n  #mt-pdp .cmp-table thead th.us{background:var(--accent);color:#06121A;border-radius:10px 10px 0 0;font-size:13px;}\n  #mt-pdp .cmp-table td.us{background:rgba(41,169,221,.12);color:var(--accent);font-weight:800;}\n  #mt-pdp .cmp-table tbody tr:last-child td.us{border-radius:0 0 10px 10px;}\n  #mt-pdp .cmp-table td.other{color:#7C8896;font-weight:700;}\n  #mt-pdp .cmp-table tbody tr td:first-child,#mt-pdp .cmp-table tbody tr td.other{border-bottom:1px solid var(--border);}\n  #mt-pdp .cmp-table tbody tr:last-child td{border-bottom:none;}\n  #mt-pdp .faq{max-width:760px;margin:0 auto;}\n  #mt-pdp .faq-item{border:1px solid var(--border);border-radius:12px;margin-bottom:12px;overflow:hidden;background:var(--panel2);}\n  #mt-pdp .faq-q{width:100%;text-align:left;background:none;border:none;padding:18px 20px;font-size:16px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;color:var(--cream);}\n  #mt-pdp .faq-q .pl{font-size:22px;transition:transform .2s;color:var(--accent);}\n  #mt-pdp .faq-a{padding:0 20px;max-height:0;overflow:hidden;transition:max-height .25s,padding .25s;color:var(--text);font-size:15px;}\n  #mt-pdp .faq-item.open .faq-a{padding:0 20px 18px;max-height:400px;}\n  #mt-pdp .faq-item.open .pl{transform:rotate(45deg);}\n  #mt-pdp .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}\n  #mt-pdp .trust .ti{text-align:center;}\n  #mt-pdp .trust .ti .ico{width:58px;height:58px;border-radius:50%;background:rgba(41,169,221,.12);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:26px;}\n  #mt-pdp .trust .ti h3{font-size:16px;margin:0 0 4px;color:var(--cream);}#mt-pdp .trust .ti p{font-size:13px;color:var(--text);margin:0;}\n  @media(max-width:760px){#mt-pdp .trust{grid-template-columns:1fr 1fr;}}\n  #mt-pdp .ft{background:#06080B;color:var(--cream);padding:54px 0 0;border-top:1px solid var(--border);}\n  #mt-pdp .ft a{color:var(--cream);text-decoration:none;opacity:.8;}#mt-pdp .ft a:hover{opacity:1;color:var(--accent);}\n  #mt-pdp .ft-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:40px;}\n  #mt-pdp .ft .name{font-size:22px;font-weight:900;text-transform:uppercase;letter-spacing:1px;}#mt-pdp .ft .name span{color:var(--accent);}\n  #mt-pdp .ft p.tag{opacity:.8;font-size:14px;max-width:280px;color:var(--text);}\n  #mt-pdp .ft h4{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin:0 0 14px;color:var(--cream);}\n  #mt-pdp .ft ul{list-style:none;padding:0;margin:0;}#mt-pdp .ft li{margin-bottom:10px;font-size:14px;}\n  #mt-pdp .ft .news input{padding:11px 14px;border:1px solid var(--border);background:var(--panel);color:var(--cream);border-radius:8px;font-size:14px;width:100%;margin-bottom:8px;}\n  #mt-pdp .ft .news button{background:var(--accent);color:#06121A;border:none;border-radius:8px;padding:11px 18px;font-weight:800;cursor:pointer;width:100%;}\n  #mt-pdp .ft-bottom{border-top:1px solid var(--border);padding:20px 0;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center;}\n  #mt-pdp .ft-bottom p{margin:0;font-size:13px;opacity:.6;color:var(--text);}\n  #mt-pdp .ft-cod span{background:rgba(41,169,221,.12);border:1px solid var(--border);border-radius:5px;padding:4px 10px;font-size:12px;font-weight:700;}\n  @media(max-width:760px){#mt-pdp .ft-grid{grid-template-columns:1fr 1fr;}}\n  #mt-pdp .sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(11,13,17,.97);border-top:1px solid var(--border);box-shadow:0 -4px 20px rgba(0,0,0,.4);transform:translateY(110%);transition:transform .3s;}\n  #mt-pdp .sticky.show{transform:translateY(0);}\n  #mt-pdp .sticky-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;max-width:1140px;margin:0 auto;}\n  #mt-pdp .sticky .sname{font-weight:800;font-size:15px;color:var(--cream);}#mt-pdp .sticky .sprice{color:var(--accent);font-weight:800;}\n  #mt-pdp .sticky .btn{width:auto;padding:12px 26px;font-size:15px;}\n  @media(max-width:600px){#mt-pdp .sticky .sname{display:none;}}\n  #mt-pdp .pop{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9998;display:none;align-items:center;justify-content:center;padding:20px;}\n  #mt-pdp .pop.show{display:flex;}\n  #mt-pdp .pop-box{background:var(--panel);border:1px solid var(--border);border-radius:16px;max-width:420px;width:100%;padding:30px;text-align:center;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.6);}\n  #mt-pdp .pop-box h3{font-size:24px;font-weight:800;margin:0 0 8px;color:var(--cream);text-transform:uppercase;}#mt-pdp .pop-box p{color:var(--text);margin:0 0 16px;}\n  #mt-pdp .pop-box input{width:100%;padding:14px;border:1px solid var(--border);background:var(--dark);color:var(--cream);border-radius:10px;font-size:15px;margin-bottom:10px;}\n  #mt-pdp .pop-box .btn{width:100%;}\n  #mt-pdp .pop-close{position:absolute;top:12px;right:14px;background:none;border:none;font-size:24px;cursor:pointer;color:var(--cream);line-height:1;}\n  #mt-pdp .priv{position:fixed;left:0;right:0;bottom:0;z-index:9997;background:#06080B;border-top:1px solid var(--border);color:var(--cream);padding:16px 20px;box-shadow:0 -4px 24px rgba(0,0,0,.4);display:none;}\n  #mt-pdp .priv.show{display:block;}\n  #mt-pdp .priv-in{max-width:1140px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;}\n  #mt-pdp .priv-in p{margin:0;font-size:14px;flex:1;min-width:240px;color:var(--text);}\n  #mt-pdp .priv-btns{display:flex;gap:10px;}#mt-pdp .priv-btns button{border-radius:8px;padding:10px 22px;font-weight:700;font-size:14px;cursor:pointer;border:none;}\n  #mt-pdp .priv-dec{background:transparent;color:var(--cream);border:1px solid var(--border)!important;}#mt-pdp .priv-acc{background:var(--accent);color:#06121A;}\n  #mt-pdp .cd-ov{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9990;opacity:0;visibility:hidden;transition:opacity .25s;}\n  #mt-pdp .cd-ov.open{opacity:1;visibility:visible;}\n  #mt-pdp .cd{position:fixed;top:0;right:0;bottom:0;width:400px;max-width:90vw;background:var(--panel);z-index:9991;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s;border-left:1px solid var(--border);}\n  #mt-pdp .cd.open{transform:translateX(0);}\n  #mt-pdp .cd-head{display:flex;align-items:center;justify-content:space-between;padding:20px;border-bottom:1px solid var(--border);}\n  #mt-pdp .cd-head h3{margin:0;font-size:18px;font-weight:800;color:var(--cream);text-transform:uppercase;}\n  #mt-pdp .cd-close{background:none;border:none;font-size:26px;cursor:pointer;color:var(--cream);}\n  #mt-pdp .cd-items{flex:1;overflow-y:auto;padding:16px 20px;}\n  #mt-pdp .cd-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);}\n  #mt-pdp .cd-item img{width:62px;height:62px;object-fit:cover;border-radius:10px;background:#fff;}\n  #mt-pdp .cd-title{font-weight:700;font-size:14px;color:var(--cream);text-decoration:none;}\n  #mt-pdp .cd-qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:8px;margin-top:6px;}\n  #mt-pdp .cd-qty button{width:28px;height:28px;border:none;background:none;cursor:pointer;font-size:16px;color:var(--cream);}\n  #mt-pdp .cd-qty span{width:30px;text-align:center;font-size:13px;font-weight:700;color:var(--cream);}\n  #mt-pdp .cd-rm{background:none;border:none;color:#7C8896;font-size:12px;cursor:pointer;text-decoration:underline;padding:0;margin-top:4px;}\n  #mt-pdp .cd-foot{padding:20px;border-top:1px solid var(--border);}\n  #mt-pdp .cd-sub{display:flex;justify-content:space-between;font-weight:800;font-size:16px;margin-bottom:6px;color:var(--cream);}\n  #mt-pdp .cd-co{display:block;text-align:center;background:var(--accent);color:#06121A;border-radius:8px;padding:15px;font-weight:800;text-decoration:none;}\n  #mt-pdp .cd-empty{text-align:center;color:#7C8896;padding:60px 20px;}\n</style>\n\n<div id=\"mt-pdp\">\n  <div class=\"ann\"><div class=\"ann-track\">\n    {%- for i in (1..2) -%}\n      <span>🔧 Premium automotive tech &amp; accessories</span><span>🚚 FREE delivery on every order</span><span>💵 Cash on Delivery available</span><span>⭐ Built for drivers who care</span>\n    {%- endfor -%}\n  </div></div>\n\n  <header class=\"hdr\"><div class=\"hdr-in\">\n    <a class=\"hdr-logo\" href=\"{{ routes.root_url }}\">{%- if logo_url != blank -%}<img src=\"{{ logo_url }}\" alt=\"MotorTech\">{%- elsif shop.brand.logo -%}<img src=\"{{ shop.brand.logo | image_url: width: 300 }}\" alt=\"{{ shop.name | escape }}\">{%- else -%}Motor<span>Tech</span>{%- endif -%}</a>\n    <nav class=\"hdr-nav\">\n      <a href=\"{{ routes.root_url }}\">Home</a>\n      <a href=\"{{ routes.all_products_collection_url }}\">Shop</a>\n      <a href=\"/pages/about\">About</a>\n      <a href=\"/pages/contact\">Contact</a>\n    </nav>\n    <div class=\"hdr-act\">\n      <a href=\"{{ routes.search_url }}\" aria-label=\"Search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></a>\n      <a href=\"{{ routes.account_url }}\" aria-label=\"Login\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-6 8-6s8 2 8 6\"/></svg></a>\n      <button class=\"hdr-cart\" onclick=\"mtCartOpen()\" aria-label=\"Cart\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg><span class=\"hdr-count\" id=\"mt-count\">{{ cart.item_count }}</span></button>\n    </div>\n  </div></header>\n\n  <div class=\"wrap\">\n    <div class=\"crumb\"><a href=\"{{ routes.root_url }}\">Home</a> / <a href=\"{{ routes.all_products_collection_url }}\">Shop</a> / {{ p.title }}</div>\n    <div class=\"pc\">\n      <div class=\"gallery\">\n        {%- if p.featured_image -%}\n          <img class=\"main\" id=\"mt-main\" src=\"{{ p.featured_image | image_url: width:900 }}\" alt=\"{{ p.title | escape }}\">\n          {%- if p.images.size > 1 -%}\n            <div class=\"thumbs\">\n              {%- for img in p.images limit:6 -%}\n                <img src=\"{{ img | image_url: width:160 }}\" class=\"{% if forloop.first %}active{% endif %}\" onclick=\"mtSwap('{{ img | image_url: width:900 }}',this)\" alt=\"\">\n              {%- endfor -%}\n            </div>\n          {%- endif -%}\n        {%- else -%}<div class=\"main\"></div>{%- endif -%}\n      </div>\n\n      <div class=\"info\">\n        <span class=\"stars\">★★★★★</span> <span style=\"color:#7C8896;font-size:13px;font-weight:600;\">4.9 · loved by drivers</span>\n        <h1>{{ p.title }}</h1>\n\n        {%- form 'product', p, id:'mt-form' -%}\n          <div class=\"price-row\">\n            <span class=\"price\" id=\"mt-price\">{{ cur.price | money }}</span>\n            {%- if cur.compare_at_price > cur.price -%}\n              <span class=\"compare\">{{ cur.compare_at_price | money }}</span>\n              {%- assign diff = cur.compare_at_price | minus: cur.price -%}\n              {%- assign pct = diff | times:100 | divided_by: cur.compare_at_price -%}\n              <span class=\"sale-badge\">SALE {{ pct }}% OFF</span>\n            {%- endif -%}\n          </div>\n          <p class=\"pc-desc\">{{ p.description | strip_html | truncatewords: 45 }}</p>\n\n          <div class=\"brew\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4l3 2\"/></svg>\n            <span><b>Quick &amp; easy:</b> Most jobs take just a few minutes — see the full how-to-use guide below.</span>\n          </div>\n\n          <div class=\"countdown\">\n            <div class=\"cd-label\">⏰ Hurry! Sale ends in</div>\n            <div class=\"cd-clock\">\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-h\">00</div><div class=\"cd-cap\">Hrs</div></div><span class=\"cd-sep\">:</span>\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-m\">00</div><div class=\"cd-cap\">Min</div></div><span class=\"cd-sep\">:</span>\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-s\">00</div><div class=\"cd-cap\">Sec</div></div>\n            </div>\n          </div>\n\n          {%- unless p.has_only_default_variant -%}\n            {%- for opt in p.options_with_values -%}\n              <div class=\"opt\"><label>{{ opt.name }}</label>\n                <div class=\"swatches\">\n                  {%- for val in opt.values -%}\n                    <div class=\"swatch {% if opt.selected_value == val %}active{% endif %}\" data-value=\"{{ val | escape }}\" onclick=\"mtOpt(this,{{ forloop.parentloop.index0 }})\">{{ val }}</div>\n                  {%- endfor -%}\n                </div>\n              </div>\n            {%- endfor -%}\n          {%- endunless -%}\n          <select name=\"id\" id=\"mt-sel\" style=\"display:none;\">\n            {%- for v in p.variants -%}\n              <option value=\"{{ v.id }}\" {% if v == cur %}selected{% endif %} {% unless v.available %}disabled{% endunless %} data-price=\"{{ v.price | money }}\" {% for o in v.options %}data-opt{{ forloop.index0 }}=\"{{ o | escape }}\"{% endfor %}>{{ v.title }}</option>\n            {%- endfor -%}\n          </select>\n\n          <div class=\"opt\"><label>Quantity</label>\n            <div class=\"qty\"><button type=\"button\" onclick=\"mtQty(-1)\">−</button><input type=\"number\" name=\"quantity\" id=\"mt-qty\" value=\"1\" min=\"1\"><button type=\"button\" onclick=\"mtQty(1)\">+</button></div>\n          </div>\n\n          <button type=\"submit\" class=\"btn\" id=\"mt-atc\" {% unless cur.available %}disabled{% endunless %}>{% if cur.available %}Add to Cart — {{ cur.price | money }}{% else %}Sold Out{% endif %}</button>\n\n          <div class=\"delivery\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 3h15v13H1zM16 8h4l3 3v5h-7\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n            <span>Order now to receive by <b id=\"mt-delivery\">—</b></span>\n          </div>\n          <div class=\"pc-badges\">\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z\"/></svg> Quality tested</span>\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><path d=\"M2 10h20\"/></svg> Cash on delivery</span>\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 12l2 2 4-4\"/></svg> Easy to use</span>\n          </div>\n        {%- endform -%}\n      </div>\n    </div>\n  </div>\n\n  <section class=\"sect\"><div class=\"wrap\">\n    {%- assign h = p.handle -%}\n    {%- if h contains 'scratch' or h contains 'eraser' or h contains 'paint' or h contains 'swirl' -%}\n      <span class=\"ben-eyebrow\">Restore Your Paint</span>\n      <h2 class=\"h2\">Why You'll Love It</h2>\n      <p class=\"lead\">A fast, DIY scratch remover that reduces light scratches, swirl marks and surface scuffs — restoring your car's finish without a trip to the body shop.</p>\n      <div class=\"benefits\">\n        <div class=\"bcard\"><div class=\"bi\">✨</div><div><h3>Erases Light Scratches</h3><p>Reduces or removes shallow scratches and surface marks that haven't cut through the clear coat.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🌀</div><div><h3>Clears Swirl Marks</h3><p>Buffs away the swirls and fine scuffs left behind by washing, drying or daily wear.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🛠️</div><div><h3>Easy DIY Application</h3><p>No tools or experience needed — just apply, rub in, and wipe off for a noticeably cleaner finish.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🚗</div><div><h3>Safe on Your Finish</h3><p>Formulated for automotive paintwork and clear coat — works across most colors and finishes.</p></div></div>\n      </div>\n      <div class=\"prep-grid\">\n        <div class=\"prep\"><h3>🧴 How to Apply</h3>Wash and dry the area first. Apply a small amount to a clean microfiber cloth, rub into the scratch using firm circular motions, then buff off with a dry cloth. Repeat for deeper marks.</div>\n        <div class=\"warn\"><h3>ℹ️ Good to Know</h3>Works best on light, shallow scratches that don't catch your fingernail. Deep scratches through the clear coat may be reduced but not fully removed. Always test on a small area first.</div>\n      </div>\n    {%- else -%}\n      <h2 class=\"h2\">About This Product</h2>\n      <div style=\"max-width:760px;margin:0 auto;color:var(--text);font-size:15px;\">{{ p.description }}</div>\n      <div class=\"prep-grid\" style=\"margin-top:24px;\">\n        <div class=\"prep\"><h3>🛠️ How to Use</h3>Follow the directions included with your product for best results. Reach out to our support team any time if you have questions.</div>\n      </div>\n    {%- endif -%}\n  </div></section>\n\n  {%- assign coll = p.collections.first -%}\n  {%- if coll and coll.products.size > 1 -%}\n  <section class=\"sect alt\"><div class=\"wrap\">\n    <h2 class=\"h2\">You May Also Like</h2><p class=\"lead\">Explore more from the MotorTech range.</p>\n    <div class=\"rel\">\n      {%- assign shown = 0 -%}\n      {%- for rp in coll.products -%}\n        {%- if rp.id != p.id and shown < 4 -%}\n          {%- assign shown = shown | plus: 1 -%}\n          <a href=\"{{ rp.url }}\"><div class=\"card\">\n            <img src=\"{{ rp.featured_image | image_url: width:400 }}\" alt=\"{{ rp.title | escape }}\">\n            <div class=\"body\"><div class=\"nm\">{{ rp.title | truncate: 40 }}</div><div class=\"pr\">{{ rp.price | money }}</div></div>\n          </div></a>\n        {%- endif -%}\n      {%- endfor -%}\n    </div>\n  </div></section>\n  {%- endif -%}\n\n  <section class=\"sect\"><div class=\"wrap\"><div class=\"split\">\n    <div>{%- if p.images[1] -%}<img src=\"{{ p.images[1] | image_url: width:700 }}\" alt=\"\">{%- elsif p.featured_image -%}<img src=\"{{ p.featured_image | image_url: width:700 }}\" alt=\"\">{%- else -%}<div class=\"ph\">🚗</div>{%- endif -%}</div>\n    <div>\n      <span class=\"eyebrow\">Simple Steps</span>\n      <h2>How to Use</h2>\n      <ul class=\"steps\">\n        <li>Clean and dry the surface so it's free of dirt and dust.</li>\n        <li>Apply a small amount to a clean microfiber cloth.</li>\n        <li>Work it into the area using firm, even circular motions.</li>\n        <li>Buff off any residue with a dry cloth — repeat if needed.</li>\n      </ul>\n      <p style=\"color:var(--text);margin-top:16px;font-size:13px;\">Tip: Always test on a small, hidden area first and follow the product label.</p>\n    </div>\n  </div></div></section>\n\n  <section class=\"sect alt\"><div class=\"wrap\">\n    <h2 class=\"h2\">MotorTech vs Others</h2><p class=\"lead\">See why drivers choose us — and stay.</p>\n    <div class=\"cmp\"><table class=\"cmp-table\">\n      <thead><tr><th></th><th class=\"us\">MotorTech</th><th>Others</th></tr></thead>\n      <tbody>\n        <tr><td>Quality-tested products</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n        <tr><td>Easy DIY — no special tools</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n        <tr><td>Safe on your vehicle</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n        <tr><td>Free delivery + cash on delivery</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n        <tr><td>Responsive local support</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n        <tr><td>30-day satisfaction guarantee</td><td class=\"us\">✓ Yes</td><td class=\"other\">✕ No</td></tr>\n      </tbody>\n    </table></div>\n  </div></section>\n\n  <section class=\"sect\"><div class=\"wrap\">\n    <h2 class=\"h2\">Frequently Asked Questions</h2>\n    <div class=\"faq\" style=\"margin-top:28px;\">\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">How do I use it? <span class=\"pl\">+</span></button><div class=\"faq-a\">Clean and dry the surface, apply a small amount to a microfiber cloth, work it in with firm circular motions, then buff off. Always check the product label for specific directions.</div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">Is it safe for my car? <span class=\"pl\">+</span></button><div class=\"faq-a\">Yes — it's formulated for automotive surfaces. We always recommend testing on a small, hidden area first to be sure.</div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">Will it work on deep scratches? <span class=\"pl\">+</span></button><div class=\"faq-a\">It works best on light, shallow scratches and swirl marks. Deeper scratches that have gone through the clear coat may be reduced but not fully removed.</div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">How long does delivery take? <span class=\"pl\">+</span></button><div class=\"faq-a\">Orders are processed quickly and typically arrive within a few days. You'll get an estimated delivery date at checkout.</div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">Can I pay cash on delivery? <span class=\"pl\">+</span></button><div class=\"faq-a\">Yes — cash on delivery is available. You only pay when your order arrives.</div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" onclick=\"mtFaq(this)\">What is your return policy? <span class=\"pl\">+</span></button><div class=\"faq-a\">We offer a 30-day satisfaction guarantee. If you're not happy, contact us and we'll make it right.</div></div>\n    </div>\n  </div></section>\n\n  <section class=\"sect alt\"><div class=\"wrap\"><div class=\"trust\">\n    <div class=\"ti\"><div class=\"ico\">🛡️</div><h3>Quality Tested</h3><p>Vetted for real performance.</p></div>\n    <div class=\"ti\"><div class=\"ico\">🚚</div><h3>Free Delivery</h3><p>On every order, no minimum.</p></div>\n    <div class=\"ti\"><div class=\"ico\">💵</div><h3>Cash on Delivery</h3><p>Pay when it arrives.</p></div>\n    <div class=\"ti\"><div class=\"ico\">💬</div><h3>Friendly Support</h3><p>We reply within 24 hours.</p></div>\n  </div></div></section>\n\n  <footer class=\"ft\"><div class=\"wrap\">\n    <div class=\"ft-grid\">\n      <div><div class=\"name\">Motor<span>Tech</span></div><p class=\"tag\">Automotive tech &amp; accessories for drivers who care. Upgrade your drive.</p></div>\n      <div><h4>Shop</h4><ul><li><a href=\"{{ routes.all_products_collection_url }}\">All Products</a></li><li><a href=\"{{ p.url }}\">{{ p.title | truncate: 22 }}</a></li></ul></div>\n      <div><h4>Help</h4><ul><li><a href=\"/pages/contact\">Contact</a></li><li><a href=\"/pages/shipping\">Shipping</a></li><li><a href=\"/pages/returns\">Returns</a></li></ul></div>\n      <div class=\"news\"><h4>Stay in touch</h4>\n        {%- form 'customer' -%}<input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,footer\"><input type=\"email\" name=\"contact[email]\" placeholder=\"Your email\" required><button type=\"submit\">Subscribe</button>{%- if form.posted_successfully? -%}<p style=\"color:var(--accent);margin-top:8px;font-size:13px;\">Subscribed — thank you!</p>{%- endif -%}{%- endform -%}\n      </div>\n    </div>\n    <div class=\"ft-bottom\"><p>© {{ 'now' | date: '%Y' }} MotorTech. All rights reserved.</p><div class=\"ft-cod\"><span>💵 Cash on Delivery</span></div></div>\n  </div></footer>\n\n  <div class=\"sticky\" id=\"mt-sticky\"><div class=\"sticky-in\">\n    <div><span class=\"sname\">{{ p.title }}</span> <span class=\"sprice\" id=\"mt-sprice\">{{ cur.price | money }}</span></div>\n    <button type=\"submit\" form=\"mt-form\" class=\"btn\">Add to Cart</button>\n  </div></div>\n\n  <div class=\"pop\" id=\"mt-pop\"><div class=\"pop-box\">\n    <button class=\"pop-close\" onclick=\"mtPopClose()\">×</button>\n    <h3>Get 10% Off</h3><p>Sign up and save 10% on your first order.</p>\n    {%- form 'customer' -%}<input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,popup\"><input type=\"email\" name=\"contact[email]\" placeholder=\"Enter your email\" required><button type=\"submit\" class=\"btn\">Claim My 10%</button>{%- endform -%}\n  </div></div>\n\n  <div class=\"priv\" id=\"mt-priv\"><div class=\"priv-in\"><p>We use cookies to improve your experience and analyze site traffic.</p><div class=\"priv-btns\"><button class=\"priv-dec\" onclick=\"mtConsent('declined')\">Decline</button><button class=\"priv-acc\" onclick=\"mtConsent('accepted')\">Accept</button></div></div></div>\n\n  <div class=\"cd-ov\" id=\"mt-cd-ov\" onclick=\"mtCartClose()\"></div>\n  <aside class=\"cd\" id=\"mt-cd\" aria-label=\"Cart\">\n    <div class=\"cd-head\"><h3>Your Cart (<span id=\"mt-cd-count\">{{ cart.item_count }}</span>)</h3><button class=\"cd-close\" onclick=\"mtCartClose()\">×</button></div>\n    <div class=\"cd-items\" id=\"mt-cd-items\"></div><div class=\"cd-foot\" id=\"mt-cd-foot\"></div>\n  </aside>\n</div>\n\n<script>\n(function(){\n  var COUNTDOWN_HOURS = 12;\n  function fmt(c){ return \"$\"+(c/100).toFixed(2); }\n  window.mtSwap=function(src,el){ document.getElementById(\"mt-main\").src=src; el.parentNode.querySelectorAll(\"img\").forEach(function(i){i.classList.remove(\"active\");}); el.classList.add(\"active\"); };\n  window.mtQty=function(d){ var i=document.getElementById(\"mt-qty\"); i.value=Math.max(1,(parseInt(i.value)||1)+d); };\n  var sel=document.getElementById(\"mt-sel\");\n  window.mtOpt=function(el,gi){\n    el.parentNode.querySelectorAll(\".swatch\").forEach(function(s){s.classList.remove(\"active\");}); el.classList.add(\"active\");\n    if(!sel) return;\n    var groups=document.querySelectorAll(\"#mt-pdp .swatches\"),chosen=[];\n    groups.forEach(function(g){var a=g.querySelector(\".swatch.active\");chosen.push(a?a.getAttribute(\"data-value\"):null);});\n    for(var i=0;i<sel.options.length;i++){\n      var ok=true;\n      for(var k=0;k<chosen.length;k++){ if(chosen[k]&&sel.options[i].getAttribute(\"data-opt\"+k)!==chosen[k]){ok=false;break;} }\n      if(ok){ sel.selectedIndex=i; var pr=sel.options[i].getAttribute(\"data-price\"),dis=sel.options[i].disabled;\n        document.getElementById(\"mt-price\").textContent=pr; var sp=document.getElementById(\"mt-sprice\"); if(sp) sp.textContent=pr;\n        var b=document.getElementById(\"mt-atc\"); if(b){ b.disabled=dis; b.textContent=dis?\"Sold Out\":(\"Add to Cart — \"+pr); } break; }\n    }\n  };\n  window.mtFaq=function(b){ b.parentNode.classList.toggle(\"open\"); };\n  (function(){\n    var hEl=document.getElementById(\"mt-cd-h\"),mEl=document.getElementById(\"mt-cd-m\"),sEl=document.getElementById(\"mt-cd-s\"); if(!hEl) return;\n    var key=\"mt-deadline\",dl=parseInt(localStorage.getItem(key));\n    if(!dl||isNaN(dl)||dl<Date.now()){ dl=Date.now()+COUNTDOWN_HOURS*3600*1000; localStorage.setItem(key,dl); }\n    function pad(n){ return n<10?\"0\"+n:\"\"+n; }\n    function tick(){ var diff=Math.max(0,dl-Date.now()),s=Math.floor(diff/1000);\n      hEl.textContent=pad(Math.floor(s/3600)); mEl.textContent=pad(Math.floor(s%3600/60)); sEl.textContent=pad(s%60);\n      if(diff<=0){ dl=Date.now()+COUNTDOWN_HOURS*3600*1000; localStorage.setItem(key,dl); } }\n    tick(); setInterval(tick,1000);\n  })();\n  (function(){ var el=document.getElementById(\"mt-delivery\"); if(!el) return;\n    var o={weekday:\"long\",month:\"long\",day:\"numeric\"},a=new Date(Date.now()+2*864e5),b=new Date(Date.now()+4*864e5);\n    el.textContent=a.toLocaleDateString(undefined,o)+\" – \"+b.toLocaleDateString(undefined,o); })();\n  var atc=document.getElementById(\"mt-atc\"),sticky=document.getElementById(\"mt-sticky\");\n  if(atc&&sticky){ window.addEventListener(\"scroll\",function(){ var r=atc.getBoundingClientRect(); sticky.classList.toggle(\"show\",r.bottom<0); },{passive:true}); }\n  window.mtPopClose=function(){ document.getElementById(\"mt-pop\").classList.remove(\"show\"); localStorage.setItem(\"mt-popup\",Date.now()); };\n  setTimeout(function(){ var l=localStorage.getItem(\"mt-popup\"); if(!l||(Date.now()-l)>7*864e5) document.getElementById(\"mt-pop\").classList.add(\"show\"); },6000);\n  document.getElementById(\"mt-pop\").addEventListener(\"click\",function(e){ if(e.target.id===\"mt-pop\") mtPopClose(); });\n  window.mtConsent=function(c){ localStorage.setItem(\"mt-consent\",c); if(window.Shopify&&Shopify.customerPrivacy){try{Shopify.customerPrivacy.setTrackingConsent(c===\"accepted\");}catch(e){}} document.getElementById(\"mt-priv\").classList.remove(\"show\"); };\n  if(!localStorage.getItem(\"mt-consent\")) document.getElementById(\"mt-priv\").classList.add(\"show\");\n  var ov=document.getElementById(\"mt-cd-ov\"),cd=document.getElementById(\"mt-cd\"),itemsEl=document.getElementById(\"mt-cd-items\"),footEl=document.getElementById(\"mt-cd-foot\");\n  function render(cart){\n    document.getElementById(\"mt-cd-count\").textContent=cart.item_count;\n    var hc=document.getElementById(\"mt-count\"); if(hc) hc.textContent=cart.item_count;\n    if(cart.item_count===0){ itemsEl.innerHTML='<div class=\"cd-empty\"><p>Your cart is empty.</p></div>'; footEl.innerHTML=\"\"; return; }\n    var h=\"\";\n    cart.items.forEach(function(it,i){\n      h+='<div class=\"cd-item\"><img src=\"'+(it.image?it.image.replace(/(\\.[a-z]+)(\\?|$)/i,\"_120x$1$2\"):\"\")+'\" alt=\"\">'\n       +'<div style=\"flex:1\"><a class=\"cd-title\" href=\"'+it.url+'\">'+it.product_title+'</a>'\n       +(it.variant_title?'<div style=\"font-size:12px;color:#7C8896\">'+it.variant_title+'</div>':'')\n       +'<div class=\"cd-qty\"><button onclick=\"mtCartChange('+(i+1)+','+(it.quantity-1)+')\">−</button><span>'+it.quantity+'</span><button onclick=\"mtCartChange('+(i+1)+','+(it.quantity+1)+')\">+</button></div>'\n       +'<button class=\"cd-rm\" onclick=\"mtCartChange('+(i+1)+',0)\">Remove</button></div>'\n       +'<div style=\"font-weight:700;color:#F4ECD6\">'+fmt(it.final_line_price)+'</div></div>';\n    });\n    itemsEl.innerHTML=h;\n    footEl.innerHTML='<div class=\"cd-sub\"><span>Subtotal</span><span>'+fmt(cart.total_price)+'</span></div><p style=\"font-size:12px;color:#7C8896;margin:0 0 14px\">Cash on delivery · taxes at checkout.</p><a class=\"cd-co\" href=\"/checkout\">Checkout</a>';\n  }\n  function refresh(){ fetch(\"/cart.js\").then(function(r){return r.json();}).then(render); }\n  window.mtCartOpen=function(){ ov.classList.add(\"open\"); cd.classList.add(\"open\"); document.body.style.overflow=\"hidden\"; refresh(); };\n  window.mtCartClose=function(){ ov.classList.remove(\"open\"); cd.classList.remove(\"open\"); document.body.style.overflow=\"\"; };\n  window.mtCartChange=function(line,qty){ fetch(\"/cart/change.js\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({line:line,quantity:qty})}).then(function(r){return r.json();}).then(render); };\n  document.addEventListener(\"submit\",function(e){ if(e.target.id===\"mt-form\"){ e.preventDefault(); fetch(\"/cart/add.js\",{method:\"POST\",body:new FormData(e.target)}).then(function(r){return r.json();}).then(function(){ mtCartOpen(); }); } });\n  refresh();\n})();\n</script>",
        "add_vertical_spacing": true,
        "background_type": "full_width",
        "background": "rgba(0,0,0,0)",
        "text_color": "rgba(0,0,0,0)"
      }
    }
  },
