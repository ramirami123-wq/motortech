        "subheading": "",
        "title": "",
        "liquid": "{%- comment -%} MOTORTECH — PRODUCT PAGE (dark navy · full width) {%- endcomment -%}\n{%- assign logo_url = \"https://cdn.shopify.com/s/files/1/0752/5403/8702/files/image_2026-06-05_005144225-removebg-preview.png?v=1781555089\" -%}\n{%- assign p = product -%}\n{%- unless p -%}{%- assign p = collections.all.products.first -%}{%- endunless -%}\n{%- assign cur = p.selected_or_first_available_variant -%}\n\n<style>\n  #mt-pdp{--bg:#091f44;--alt:#0b2450;--accent:#1E93CF;--accent2:#1681B8;--ink:#FFFFFF;--text:#A8C0D6;--border:#1a3560;--foot:#060f22;--sale:#1E93CF;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.6;background:var(--bg);position:relative;width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;}\n  #mt-pdp *{box-sizing:border-box;}\n  #mt-pdp img{max-width:100%;display:block;}\n  #mt-pdp .wrap{max-width:100%;margin:0 auto;padding:0 24px;}\n  #mt-pdp .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--accent);color:#fff;font-weight:800;font-size:16px;border:none;border-radius:8px;padding:15px 32px;cursor:pointer;text-decoration:none;box-shadow:0 8px 24px rgba(30,147,207,.35);transition:transform .15s,box-shadow .15s;width:100%;}\n  #mt-pdp .btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(30,147,207,.55);}\n  #mt-pdp .btn[disabled]{background:#1a3560;color:#A8C0D6;box-shadow:none;cursor:not-allowed;}\n  #mt-pdp .stars{color:#F0A92A;letter-spacing:2px;}\n  #mt-pdp .h2{font-size:32px;font-weight:800;text-align:center;margin:0 0 8px;color:#fff;text-transform:uppercase;letter-spacing:.5px;}\n  #mt-pdp .lead{text-align:center;color:var(--text);max-width:620px;margin:0 auto 36px;}\n  #mt-pdp .sect{padding:56px 0;background:var(--bg);}\n  #mt-pdp .alt{background:var(--alt);}\n  #mt-pdp .ann{background:var(--accent);color:#fff;overflow:hidden;}\n  #mt-pdp .ann-track{display:flex;gap:60px;white-space:nowrap;padding:10px 0;animation:mt-ann 25s linear infinite;}\n  #mt-pdp .ann:hover .ann-track{animation-play-state:paused;}\n  #mt-pdp .ann span{font-size:13px;font-weight:600;letter-spacing:.4px;}\n  @keyframes mt-ann{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n\n  /* HEADER */\n  #mt-pdp .hdr{background:#091f44;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:40;}\n  #mt-pdp .hdr-in{display:flex;align-items:center;justify-content:space-between;padding:12px 24px;max-width:100%;margin:0 auto;}\n  #mt-pdp .hdr-logo{font-size:24px;font-weight:900;color:#fff;text-decoration:none;letter-spacing:1px;text-transform:uppercase;display:flex;align-items:center;}\n  #mt-pdp .hdr-logo span{color:var(--accent);}\n  #mt-pdp .hdr-logo img{height:56px;width:auto;display:block;}\n  #mt-pdp .hdr-nav{display:flex;gap:26px;}\n  #mt-pdp .hdr-nav a{color:#A8C0D6;text-decoration:none;font-weight:600;font-size:15px;transition:color .15s;}\n  #mt-pdp .hdr-nav a:hover{color:var(--accent);}\n  #mt-pdp .hdr-act{display:flex;align-items:center;gap:18px;}\n  #mt-pdp .hdr-act a,#mt-pdp .hdr-act button{background:none;border:none;cursor:pointer;color:#A8C0D6;text-decoration:none;display:flex;padding:0;transition:color .15s;}\n  #mt-pdp .hdr-act a:hover,#mt-pdp .hdr-act button:hover{color:var(--accent);}\n  #mt-pdp .hdr-act svg{width:22px;height:22px;}\n  #mt-pdp .hdr-cart{position:relative;}\n  #mt-pdp .hdr-count{position:absolute;top:-8px;right:-10px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;}\n  @media(max-width:760px){#mt-pdp .hdr-nav{display:none;}}\n\n  /* BREADCRUMB */\n  #mt-pdp .crumb{font-size:13px;color:#A8C0D6;padding:16px 0 0;}\n  #mt-pdp .crumb a{color:#A8C0D6;text-decoration:none;}\n  #mt-pdp .crumb a:hover{color:var(--accent);}\n\n  /* PRODUCT CORE */\n  #mt-pdp .pc{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:24px 0 56px;align-items:start;}\n  #mt-pdp .gallery .main{border-radius:16px;background:#0d2754;border:1px solid var(--border);aspect-ratio:1/1;object-fit:cover;width:100%;}\n  #mt-pdp .thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}\n  #mt-pdp .thumbs img{width:74px;height:74px;object-fit:cover;border-radius:10px;border:2px solid var(--border);cursor:pointer;background:#0d2754;}\n  #mt-pdp .thumbs img.active{border-color:var(--accent);}\n  #mt-pdp .pc h1{font-size:34px;font-weight:800;margin:6px 0 12px;color:#fff;}\n  #mt-pdp .price-row{display:flex;align-items:center;gap:12px;margin-bottom:6px;flex-wrap:wrap;}\n  #mt-pdp .price{font-size:30px;font-weight:800;color:var(--accent);}\n  #mt-pdp .compare{font-size:19px;color:#A8C0D6;text-decoration:line-through;}\n  #mt-pdp .sale-badge{background:var(--accent);color:#fff;font-weight:800;font-size:12px;padding:5px 10px;border-radius:6px;letter-spacing:.5px;}\n  #mt-pdp .pc-desc{color:var(--text);font-size:15px;margin:14px 0;}\n  #mt-pdp .brew{display:flex;gap:10px;align-items:flex-start;background:var(--alt);border:1px solid var(--border);border-radius:12px;padding:13px 16px;margin:14px 0;font-size:14px;color:var(--text);}\n  #mt-pdp .brew svg{width:20px;height:20px;color:var(--accent);flex:none;margin-top:2px;}\n  #mt-pdp .brew b{color:#fff;}\n  #mt-pdp .countdown{background:var(--alt);border:1px solid var(--border);border-radius:12px;padding:14px 16px;text-align:center;margin:16px 0;}\n  #mt-pdp .countdown .cd-label{font-size:13px;font-weight:700;margin-bottom:8px;color:#fff;}\n  #mt-pdp .countdown .cd-clock{display:flex;justify-content:center;align-items:center;gap:8px;}\n  #mt-pdp .countdown .cd-unit{background:var(--accent);color:#fff;border-radius:8px;min-width:54px;padding:8px 6px;}\n  #mt-pdp .countdown .cd-num{font-size:22px;font-weight:800;line-height:1;}\n  #mt-pdp .countdown .cd-cap{font-size:10px;opacity:.85;text-transform:uppercase;letter-spacing:.5px;}\n  #mt-pdp .countdown .cd-sep{font-size:20px;font-weight:800;color:var(--accent);}\n  #mt-pdp .opt{margin:14px 0;}\n  #mt-pdp .opt label{display:block;font-weight:700;font-size:13px;margin-bottom:7px;color:#fff;}\n  #mt-pdp .swatches{display:flex;flex-wrap:wrap;gap:8px;}\n  #mt-pdp .swatch{border:2px solid var(--border);border-radius:8px;padding:9px 16px;cursor:pointer;font-weight:600;font-size:14px;background:#0d2754;color:#fff;}\n  #mt-pdp .swatch.active{border-color:var(--accent);background:#0f3060;color:var(--accent);}\n  #mt-pdp .qty{display:inline-flex;align-items:center;border:2px solid var(--border);border-radius:8px;overflow:hidden;}\n  #mt-pdp .qty button{width:42px;height:42px;border:none;background:#0d2754;color:#fff;font-size:20px;cursor:pointer;}\n  #mt-pdp .qty input{width:46px;height:42px;text-align:center;border:none;background:#0d2754;color:#fff;font-size:16px;font-weight:700;-moz-appearance:textfield;}\n  #mt-pdp .qty input::-webkit-outer-spin-button,#mt-pdp .qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}\n  #mt-pdp .delivery{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text);background:var(--alt);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-top:14px;}\n  #mt-pdp .delivery svg{width:18px;height:18px;color:var(--accent);flex:none;}\n  #mt-pdp .delivery b{color:#fff;}\n  #mt-pdp .pc-badges{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px;}\n  #mt-pdp .pc-badges .b{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--text);}\n  #mt-pdp .pc-badges svg{width:18px;height:18px;color:var(--accent);}\n  @media(max-width:760px){#mt-pdp .pc{grid-template-columns:1fr;gap:24px;}#mt-pdp .pc h1{font-size:28px;}}\n\n  /* RELATED */\n  #mt-pdp .rel{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}\n  #mt-pdp .rel a{text-decoration:none;color:var(--ink);}\n  #mt-pdp .rel .card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#0d2754;transition:box-shadow .15s,border-color .15s;}\n  #mt-pdp .rel .card:hover{box-shadow:0 10px 30px rgba(30,147,207,.18);border-color:var(--accent);}\n  #mt-pdp .rel .card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#0d2754;}\n  #mt-pdp .rel .card .body{padding:12px;}\n  #mt-pdp .rel .card .nm{font-weight:700;font-size:14px;color:#fff;}\n  #mt-pdp .rel .card .pr{color:var(--accent);font-weight:800;font-size:14px;margin-top:4px;}\n  @media(max-width:760px){#mt-pdp .rel{grid-template-columns:1fr 1fr;}}\n\n  /* BENEFITS */\n  #mt-pdp .ben-eyebrow{display:block;text-align:center;color:var(--accent);font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;}\n  #mt-pdp .benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:32px 0 28px;}\n  #mt-pdp .bcard{display:flex;gap:14px;background:#0d2754;border:1px solid var(--border);border-radius:14px;padding:18px;align-items:flex-start;}\n  #mt-pdp .bcard .bi{width:44px;height:44px;border-radius:50%;background:#0f3060;display:flex;align-items:center;justify-content:center;font-size:22px;flex:none;}\n  #mt-pdp .bcard h3{margin:0 0 4px;font-size:16px;color:#fff;}\n  #mt-pdp .bcard p{margin:0;font-size:14px;color:var(--text);line-height:1.55;}\n  #mt-pdp .prep-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;max-width:900px;margin:0 auto;}\n  #mt-pdp .prep,#mt-pdp .warn{border-radius:14px;padding:18px 20px;font-size:14px;line-height:1.55;}\n  #mt-pdp .prep{background:var(--alt);border:1px solid var(--border);color:var(--text);}\n  #mt-pdp .prep h3{margin:0 0 6px;font-size:15px;color:#fff;}\n  #mt-pdp .warn{background:#0f3060;border:1px solid #1a4a80;color:#C5D8E8;}\n  #mt-pdp .warn h3{margin:0 0 6px;font-size:15px;color:var(--accent);}\n  @media(max-width:680px){#mt-pdp .benefits{grid-template-columns:1fr;}}\n\n  /* COMPARISON */\n  #mt-pdp .cmp{max-width:820px;margin:0 auto;}\n  #mt-pdp .cmp-table{width:100%;border-collapse:separate;border-spacing:0;}\n  #mt-pdp .cmp-table th,#mt-pdp .cmp-table td{padding:16px 14px;text-align:center;font-size:14px;}\n  #mt-pdp .cmp-table th:first-child,#mt-pdp .cmp-table td:first-child{text-align:left;font-weight:600;color:#fff;}\n  #mt-pdp .cmp-table thead th{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text);}\n  #mt-pdp .cmp-table thead th.us{background:var(--accent);color:#fff;border-radius:10px 10px 0 0;font-size:13px;}\n  #mt-pdp .cmp-table td.us{background:#0f3060;color:var(--accent);font-weight:800;}\n  #mt-pdp .cmp-table tbody tr:last-child td.us{border-radius:0 0 10px 10px;}\n  #mt-pdp .cmp-table td.other{color:#A8C0D6;font-weight:700;}\n  #mt-pdp .cmp-table tbody tr td:first-child,#mt-pdp .cmp-table tbody tr td.other{border-bottom:1px solid var(--border);}\n  #mt-pdp .cmp-table tbody tr:last-child td{border-bottom:none;}\n\n  /* FAQ */\n  #mt-pdp .faq{max-width:760px;margin:0 auto;}\n  #mt-pdp .faq-item{border:1px solid var(--border);border-radius:12px;margin-bottom:12px;overflow:hidden;background:#0d2754;}\n  #mt-pdp .faq-q{width:100%;text-align:left;background:none;border:none;padding:18px 20px;font-size:16px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;color:#fff;}\n  #mt-pdp .faq-q .pl{font-size:22px;transition:transform .2s;color:var(--accent);}\n  #mt-pdp .faq-a{padding:0 20px;max-height:0;overflow:hidden;transition:max-height .25s,padding .25s;color:var(--text);font-size:15px;}\n  #mt-pdp .faq-item.open .faq-a{padding:0 20px 18px;max-height:400px;}\n  #mt-pdp .faq-item.open .pl{transform:rotate(45deg);}\n\n  /* TRUST */\n  #mt-pdp .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}\n  #mt-pdp .trust .ti{text-align:center;}\n  #mt-pdp .trust .ti .ico{width:58px;height:58px;border-radius:50%;background:#0d2754;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:26px;}\n  #mt-pdp .trust .ti h3{font-size:16px;margin:0 0 4px;color:#fff;}\n  #mt-pdp .trust .ti p{font-size:13px;color:var(--text);margin:0;}\n  @media(max-width:760px){#mt-pdp .trust{grid-template-columns:1fr 1fr;}}\n\n  /* FOOTER */\n  #mt-pdp .ft{background:var(--foot);color:#A8C0D6;padding:54px 0 0;border-top:1px solid var(--border);}\n  #mt-pdp .ft a{color:#C5D8E8;text-decoration:none;opacity:.85;}\n  #mt-pdp .ft a:hover{opacity:1;color:var(--accent);}\n  #mt-pdp .ft-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:40px;}\n  #mt-pdp .ft .name{font-size:22px;font-weight:900;text-transform:uppercase;letter-spacing:1px;color:#fff;}\n  #mt-pdp .ft .name span{color:var(--accent);}\n  #mt-pdp .ft p.tag{opacity:.8;font-size:14px;max-width:280px;color:#A8C0D6;}\n  #mt-pdp .ft h4{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin:0 0 14px;color:#fff;}\n  #mt-pdp .ft ul{list-style:none;padding:0;margin:0;}\n  #mt-pdp .ft li{margin-bottom:10px;font-size:14px;}\n  #mt-pdp .ft .news input{padding:11px 14px;border:1px solid var(--border);background:#0d2754;color:#fff;border-radius:8px;font-size:14px;width:100%;margin-bottom:8px;}\n  #mt-pdp .ft .news input::placeholder{color:#A8C0D6;}\n  #mt-pdp .ft .news button{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:11px 18px;font-weight:800;cursor:pointer;width:100%;}\n  #mt-pdp .ft-bottom{border-top:1px solid rgba(255,255,255,.08);padding:20px 0;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center;}\n  #mt-pdp .ft-bottom p{margin:0;font-size:13px;opacity:.6;color:#A8C0D6;}\n  #mt-pdp .ft-cod span{background:rgba(255,255,255,.08);border-radius:5px;padding:4px 10px;font-size:12px;font-weight:700;color:#fff;}\n  @media(max-width:760px){#mt-pdp .ft-grid{grid-template-columns:1fr 1fr;}}\n\n  /* STICKY BAR */\n  #mt-pdp .sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;background:#091f44;border-top:1px solid var(--border);box-shadow:0 -4px 20px rgba(6,15,34,.4);transform:translateY(110%);transition:transform .3s;}\n  #mt-pdp .sticky.show{transform:translateY(0);}\n  #mt-pdp .sticky-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 24px;max-width:100%;margin:0 auto;}\n  #mt-pdp .sticky .sname{font-weight:800;font-size:15px;color:#fff;}\n  #mt-pdp .sticky .sprice{color:var(--accent);font-weight:800;}\n  #mt-pdp .sticky .btn{width:auto;padding:12px 26px;font-size:15px;}\n  @media(max-width:600px){#mt-pdp .sticky .sname{display:none;}}\n\n  /* CART DRAWER */\n  #mt-pdp .cd-ov{position:fixed;inset:0;background:rgba(6,15,34,.65);z-index:9990;opacity:0;visibility:hidden;transition:opacity .25s;}\n  #mt-pdp .cd-ov.open{opacity:1;visibility:visible;}\n  #mt-pdp .cd{position:fixed;top:0;right:0;bottom:0;width:400px;max-width:90vw;background:#0b2450;z-index:9991;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s;border-left:1px solid var(--border);}\n  #mt-pdp .cd.open{transform:translateX(0);}\n  #mt-pdp .cd-head{display:flex;align-items:center;justify-content:space-between;padding:20px;border-bottom:1px solid var(--border);}\n  #mt-pdp .cd-head h3{margin:0;font-size:18px;font-weight:800;color:#fff;text-transform:uppercase;}\n  #mt-pdp .cd-close{background:none;border:none;font-size:26px;cursor:pointer;color:#A8C0D6;}\n  #mt-pdp .cd-items{flex:1;overflow-y:auto;padding:16px 20px;}\n  #mt-pdp .cd-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);}\n  #mt-pdp .cd-item img{width:62px;height:62px;object-fit:cover;border-radius:10px;background:#0d2754;}\n  #mt-pdp .cd-title{font-weight:700;font-size:14px;color:#fff;text-decoration:none;}\n  #mt-pdp .cd-qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:8px;margin-top:6px;}\n  #mt-pdp .cd-qty button{width:28px;height:28px;border:none;background:none;cursor:pointer;font-size:16px;color:#fff;}\n  #mt-pdp .cd-qty span{width:30px;text-align:center;font-size:13px;font-weight:700;color:#fff;}\n  #mt-pdp .cd-rm{background:none;border:none;color:#A8C0D6;font-size:12px;cursor:pointer;text-decoration:underline;padding:0;margin-top:4px;}\n  #mt-pdp .cd-foot{padding:20px;border-top:1px solid var(--border);}\n  #mt-pdp .cd-sub{display:flex;justify-content:space-between;font-weight:800;font-size:16px;margin-bottom:6px;color:#fff;}\n  #mt-pdp .cd-co{display:block;text-align:center;background:var(--accent);color:#fff;border-radius:8px;padding:15px;font-weight:800;text-decoration:none;}\n  #mt-pdp .cd-empty{text-align:center;color:#A8C0D6;padding:60px 20px;}\n</style>\n\n<div id=\"mt-pdp\">\n  <div class=\"ann\"><div class=\"ann-track\">\n    {%- for i in (1..2) -%}\n      <span>🔧 Premium automotive tech &amp; accessories</span><span>🚚 FREE delivery on every order</span><span>💵 Cash on Delivery available</span><span>⭐ Built for drivers who care</span>\n    {%- endfor -%}\n  </div></div>\n\n  <header class=\"hdr\"><div class=\"hdr-in\">\n    <a class=\"hdr-logo\" href=\"{{ routes.root_url }}\">{%- if logo_url != blank -%}<img src=\"{{ logo_url }}\" alt=\"MotorTech\">{%- elsif shop.brand.logo -%}<img src=\"{{ shop.brand.logo | image_url: width: 300 }}\" alt=\"{{ shop.name | escape }}\">{%- else -%}Motor<span>Tech</span>{%- endif -%}</a>\n    <nav class=\"hdr-nav\">\n      <a href=\"{{ routes.root_url }}\">Home</a>\n      <a href=\"{{ routes.all_products_collection_url }}\">Shop</a>\n      <a href=\"/pages/about\">About</a>\n      <a href=\"/pages/contact\">Contact</a>\n    </nav>\n    <div class=\"hdr-act\">\n      <a href=\"{{ routes.search_url }}\" aria-label=\"Search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg></a>\n      <a href=\"{{ routes.account_url }}\" aria-label=\"Login\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-6 8-6s8 2 8 6\"/></svg></a>\n      <button class=\"hdr-cart\" onclick=\"mtCartOpen()\" aria-label=\"Cart\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg><span class=\"hdr-count\" id=\"mt-count\">{{ cart.item_count }}</span></button>\n    </div>\n  </div></header>\n\n  <div class=\"wrap\">\n    <div class=\"crumb\"><a href=\"{{ routes.root_url }}\">Home</a> / <a href=\"{{ routes.all_products_collection_url }}\">Shop</a> / {{ p.title }}</div>\n    <div class=\"pc\">\n      <div class=\"gallery\">\n        {%- if p.featured_image -%}\n          <img class=\"main\" id=\"mt-main\" src=\"{{ p.featured_image | image_url: width:900 }}\" alt=\"{{ p.title | escape }}\">\n          {%- if p.images.size > 1 -%}\n            <div class=\"thumbs\">\n              {%- for img in p.images limit:6 -%}\n                <img src=\"{{ img | image_url: width:160 }}\" class=\"{% if forloop.first %}active{% endif %}\" onclick=\"mtSwap('{{ img | image_url: width:900 }}',this)\" alt=\"\">\n              {%- endfor -%}\n            </div>\n          {%- endif -%}\n        {%- else -%}<div class=\"main\" style=\"display:flex;align-items:center;justify-content:center;color:#A8C0D6;font-size:14px;background:#0d2754;border-radius:16px;aspect-ratio:1/1;\">Product image</div>{%- endif -%}\n      </div>\n\n      <div class=\"info\">\n        <span class=\"stars\">★★★★★</span> <span style=\"color:#A8C0D6;font-size:13px;font-weight:600;\">4.9 · loved by drivers</span>\n        <h1>{{ p.title | default: 'Product' }}</h1>\n\n        {%- if p -%}\n        {%- form 'product', p, id:'mt-form' -%}\n          {%- assign compare_cents = 3000 -%}\n          <div class=\"price-row\">\n            <span class=\"price\" id=\"mt-price\">{{ cur.price | money }}</span>\n            {%- if cur.price < compare_cents -%}\n              <span class=\"compare\">$30.00</span>\n              {%- assign save_pct = compare_cents | minus: cur.price | times: 100 | divided_by: compare_cents -%}\n              <span class=\"sale-badge\">SAVE {{ save_pct }}%</span>\n            {%- elsif cur.compare_at_price > cur.price -%}\n              <span class=\"compare\">{{ cur.compare_at_price | money }}</span>\n              {%- assign diff = cur.compare_at_price | minus: cur.price -%}\n              {%- assign pct = diff | times:100 | divided_by: cur.compare_at_price -%}\n              <span class=\"sale-badge\">SAVE {{ pct }}%</span>\n            {%- endif -%}\n          </div>\n\n          {%- assign hh = p.handle -%}\n          {%- if hh contains 'scratch' or hh contains 'eraser' or hh contains 'paint' or hh contains 'swirl' -%}\n            <p class=\"pc-desc\">A car scratch remover designed to reduce or remove visible scratches and surface marks from your vehicle's paintwork — especially shallow scratches that haven't penetrated the clear coat.</p>\n          {%- else -%}\n            <p class=\"pc-desc\">{{ p.description | strip_html | strip_newlines | replace: '        ', ' ' | replace: '      ', ' ' | replace: '    ', ' ' | replace: '   ', ' ' | replace: '  ', ' ' | replace: '  ', ' ' | strip | truncatewords: 45 }}</p>\n          {%- endif -%}\n\n          <div class=\"brew\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4l3 2\"/></svg>\n            <span><b>Quick &amp; easy:</b> Most jobs take just a few minutes — see the full how-to-use guide below.</span>\n          </div>\n\n          <div class=\"countdown\">\n            <div class=\"cd-label\">⏰ Hurry! Sale ends in</div>\n            <div class=\"cd-clock\">\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-h\">00</div><div class=\"cd-cap\">Hrs</div></div><span class=\"cd-sep\">:</span>\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-m\">00</div><div class=\"cd-cap\">Min</div></div><span class=\"cd-sep\">:</span>\n              <div class=\"cd-unit\"><div class=\"cd-num\" id=\"mt-cd-s\">00</div><div class=\"cd-cap\">Sec</div></div>\n            </div>\n          </div>\n\n          {%- unless p.has_only_default_variant -%}\n            {%- for opt in p.options_with_values -%}\n              <div class=\"opt\"><label>{{ opt.name }}</label>\n                <div class=\"swatches\">\n                  {%- for val in opt.values -%}\n                    <div class=\"swatch {% if opt.selected_value == val %}active{% endif %}\" data-value=\"{{ val | escape }}\" onclick=\"mtOpt(this,{{ forloop.parentloop.index0 }})\">{{ val }}</div>\n                  {%- endfor -%}\n                </div>\n              </div>\n            {%- endfor -%}\n          {%- endunless -%}\n          <select name=\"id\" id=\"mt-sel\" style=\"display:none;\">\n            {%- for v in p.variants -%}\n              <option value=\"{{ v.id }}\" {% if v == cur %}selected{% endif %} {% unless v.available %}disabled{% endunless %} data-price=\"{{ v.price | money }}\" {% for o in v.options %}data-opt{{ forloop.index0 }}=\"{{ o | escape }}\"{% endfor %}>{{ v.title }}</option>\n            {%- endfor -%}\n          </select>\n\n          <div class=\"opt\"><label>Quantity</label>\n            <div class=\"qty\"><button type=\"button\" onclick=\"mtQty(-1)\">−</button><input type=\"number\" name=\"quantity\" id=\"mt-qty\" value=\"1\" min=\"1\"><button type=\"button\" onclick=\"mtQty(1)\">+</button></div>\n          </div>\n\n          <button type=\"submit\" class=\"btn\" id=\"mt-atc\" {% unless cur.available %}disabled{% endunless %}>{% if cur.available %}Add to Cart — {{ cur.price | money }}{% else %}Sold Out{% endif %}</button>\n\n          <div class=\"delivery\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M1 3h15v13H1zM16 8h4l3 3v5h-7\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n            <span>Order now to receive by <b id=\"mt-delivery\">—</b></span>\n          </div>\n          <div class=\"pc-badges\">\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z\"/></svg> Quality tested</span>\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><path d=\"M2 10h20\"/></svg> Cash on delivery</span>\n            <span class=\"b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 12l2 2 4-4\"/></svg> Easy to use</span>\n          </div>\n        {%- endform -%}\n        {%- else -%}\n          <p class=\"pc-desc\">This product isn't published yet — add it in your Shopify admin (Products → Add product) and it will appear here automatically.</p>\n          <a class=\"btn\" href=\"{{ routes.all_products_collection_url }}\" style=\"margin-top:12px;\">Browse Products</a>\n        {%- endif -%}\n      </div>\n    </div>\n  </div>\n\n  <section class=\"sect\"><div class=\"wrap\">\n    {%- assign h = p.handle -%}\n    {%- if h contains 'scratch' or h contains 'eraser' or h contains 'paint' or h contains 'swirl' -%}\n      <span class=\"ben-eyebrow\">Restore Your Paint</span>\n      <h2 class=\"h2\">Why You'll Love It</h2>\n      <p class=\"lead\">A fast, DIY scratch remover that reduces light scratches, swirl marks and surface scuffs — restoring your car's finish without a trip to the body shop.</p>\n      <div class=\"benefits\">\n        <div class=\"bcard\"><div class=\"bi\">✨</div><div><h3>Erases Light Scratches</h3><p>Reduces or removes shallow scratches and surface marks that haven't cut through the clear coat.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🌀</div><div><h3>Clears Swirl Marks</h3><p>Buffs away the swirls and fine scuffs left behind by washing, drying or daily wear.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🛠️</div><div><h3>Easy DIY Application</h3><p>No tools or experience needed — just apply, rub in, and wipe off for a noticeably cleaner finish.</p></div></div>\n        <div class=\"bcard\"><div class=\"bi\">🚗</div><div><h3>Safe on Your Finish</h3><p>Formulated for automotive paintwork and clear coat — works across most colors and finishes.</p></div></div>\n      </div>\n      <div class=\"prep-grid\">\n        <div class=\"prep\"><h3>🧴 How to Apply</h3>Wash and dry the area first. Apply a small amount to a clean microfiber cloth, rub into the scratch using firm circular motions, then buff off with a dry cloth. Repeat for deeper marks.</div>\n        <div class=\"warn\"><h3>ℹ️ Good to Know</h3>Works best on light, shallow scratches that don't catch your fingernail. Deep scratches through the clear coat may be reduced but not fully removed. Always test on a small area first.</div>\n      </div>\n    {%- else -%}\n      <h2 class=\"h2\">About This Product</h2>\n      <div style=\"max-width:760px;margin:0 auto;color:var(--text);font-size:15px;\">{{ p.description }}</div>\n      <div class=\"prep-grid\" style=\"margin-top:24px;\">\n        <div class=\"prep\"><h3>🛠️ How to Use</h3>Follow the directions included with your product for best results. Reach out to our support team any time if you have questions.</div>\n      </div>\n    {%- endif -%}\n  </div></section>\n\n  {%- assign coll = p.collections.first -%}\n  {%- if coll and coll.products.size > 1 -%}\n  <section class=\"sect alt\"><div class=\"wrap\">\n    <h2 class=\"h2\">You May Also Like</h2><p class=\"lead\">Explore more from the MotorTech range.</p>\n    <div class=\"rel\">\n      {%- assign shown = 0 -%}\n      {%- for rp in coll.products -%}\n        {%- if rp.id != p.id and shown < 4 -%}\n          {%- assign shown = shown | plus: 1 -%}\n          <a href=\"{{ rp.url }}\"><div class=\"card\">\n            <img src=\"{{ rp.featured_image | image_url: width:400 }}\" alt=\"{{ rp.title | escape }}\">\n            <div class=\"body\"><div class=\"nm\">{{ rp.title | truncate: 40 }}</div><div class=\"pr\">{{ rp.price | money }}</div></div>\n          </div></a>\n        {%- endif -%}\n      {%- endfor -%}\n    </div>\n  </div></section>\n  {%- endif -%}\n\n  <div class=\"sticky\" id=\"mt-sticky\">\n    <div class=\"sticky-in\">\n      <div><div class=\"sname\">{{ p.title | truncate: 40 }}</div><div class=\"sprice\" id=\"mt-sprice\">{{ cur.price | money }}</div></div>\n      <button class=\"btn\" onclick=\"document.getElementById('mt-atc').click()\">Add to Cart</button>\n    </div>\n  </div>\n\n  <div class=\"cd-ov\" id=\"mt-ov\" onclick=\"mtCartClose()\"></div>\n  <div class=\"cd\" id=\"mt-cd\">\n    <div class=\"cd-head\"><h3>Your Cart</h3><button class=\"cd-close\" onclick=\"mtCartClose()\">×</button></div>\n    <div class=\"cd-items\" id=\"mt-cd-items\"><div class=\"cd-empty\">Your cart is empty</div></div>\n    <div class=\"cd-foot\">\n      <div class=\"cd-sub\"><span>Subtotal</span><span id=\"mt-cd-total\">$0.00</span></div>\n      <a href=\"/checkout\" class=\"cd-co\">Checkout</a>\n    </div>\n  </div>\n\n<script>\n(function(){\n  var end = Date.now() + (23*3600 + 59*60 + 59)*1000;\n  function tickTimer(){\n    var left = Math.max(0, end - Date.now());\n    var h = Math.floor(left/3600000);\n    var m = Math.floor((left%3600000)/60000);\n    var s = Math.floor((left%60000)/1000);\n    var ph = document.getElementById('mt-cd-h');\n    var pm = document.getElementById('mt-cd-m');\n    var ps = document.getElementById('mt-cd-s');\n    if(ph) ph.textContent = String(h).padStart(2,'0');\n    if(pm) pm.textContent = String(m).padStart(2,'0');\n    if(ps) ps.textContent = String(s).padStart(2,'0');\n    if(left > 0) setTimeout(tickTimer, 1000);\n  }\n  tickTimer();\n  var days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\n  var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n  var d=new Date(); d.setDate(d.getDate()+3);\n  while(d.getDay()===0||d.getDay()===6) d.setDate(d.getDate()+1);\n  var el=document.getElementById('mt-delivery');\n  if(el) el.textContent=days[d.getDay()]+', '+months[d.getMonth()]+' '+d.getDate();\n  window.mtSwap=function(src,thumb){\n    var m=document.getElementById('mt-main'); if(m) m.src=src;\n    document.querySelectorAll('#mt-pdp .thumbs img').forEach(function(t){t.classList.remove('active');});\n    if(thumb) thumb.classList.add('active');\n  };\n  window.mtQty=function(d){\n    var i=document.getElementById('mt-qty'); if(!i) return;\n    i.value=Math.max(1,(parseInt(i.value)||1)+d);\n  };\n  window.mtOpt=function(el,idx){\n    var val=el.getAttribute('data-value');\n    el.closest('.swatches').querySelectorAll('.swatch').forEach(function(s){s.classList.remove('active');});\n    el.classList.add('active');\n    var sel=document.getElementById('mt-sel'); if(!sel) return;\n    var opts=Array.from(sel.options).map(function(o){\n      var v={};\n      for(var k in o.dataset) v[k]=o.dataset[k];\n      v.value=o.value; v.disabled=o.disabled; v.price=o.dataset.price;\n      return v;\n    });\n    var cur={};\n    document.querySelectorAll('#mt-pdp .swatches').forEach(function(sw,i){\n      var a=sw.querySelector('.swatch.active');\n      if(a) cur['opt'+i]=a.getAttribute('data-value');\n    });\n    cur['opt'+idx]=val;\n    var match=opts.find(function(o){\n      return Object.keys(cur).every(function(k){ return o[k]===cur[k]; });\n    });\n    if(match){\n      sel.value=match.value;\n      var p=document.getElementById('mt-price'); if(p&&match.price) p.textContent=match.price;\n      var sp=document.getElementById('mt-sprice'); if(sp&&match.price) sp.textContent=match.price;\n      var b=document.getElementById('mt-atc');\n      if(b){ if(match.disabled){b.disabled=true;b.textContent='Sold Out';}\n             else{b.disabled=false;b.textContent='Add to Cart — '+(match.price||'');}}\n    }\n  };\n  var atc=document.getElementById('mt-atc');\n  if(atc){ var obs=new IntersectionObserver(function(e){\n    var s=document.getElementById('mt-sticky');\n    if(s) s.classList.toggle('show',!e[0].isIntersecting);\n  },{threshold:0.1});\n  obs.observe(atc);}\n  function renderCart(cart){\n    var el=document.getElementById('mt-cd-items');\n    var tot=document.getElementById('mt-cd-total');\n    var cnt=document.getElementById('mt-count');\n    if(cnt) cnt.textContent=cart.item_count;\n    if(tot) tot.textContent=fmtMoney(cart.total_price);\n    if(!el) return;\n    if(!cart.items.length){el.innerHTML='<div class=\"cd-empty\">Your cart is empty</div>';return;}\n    el.innerHTML=cart.items.map(function(it){\n      return '<div class=\"cd-item\">'\n        +'<img src=\"'+it.image+'\" alt=\"\">'\n        +'<div style=\"flex:1;min-width:0;\">'\n        +'<div class=\"cd-title\">'+it.product_title+'</div>'\n        +(it.variant_title&&it.variant_title!=='Default Title'?'<div style=\"font-size:12px;color:#A8C0D6;\">'+it.variant_title+'</div>':'')\n        +'<div style=\"font-size:13px;font-weight:700;color:var(--accent);margin-top:4px;\">'+fmtMoney(it.final_line_price)+'</div>'\n        +'<div class=\"cd-qty\">'\n        +'<button onclick=\"mtCdQty('+it.variant_id+','+it.quantity+',-1)\">−</button>'\n        +'<span>'+it.quantity+'</span>'\n        +'<button onclick=\"mtCdQty('+it.variant_id+','+it.quantity+',1)\">+</button>'\n        +'</div>'\n        +'<button class=\"cd-rm\" onclick=\"mtCdQty('+it.variant_id+','+it.quantity+',-'+it.quantity+')\">Remove</button>'\n        +'</div></div>';\n    }).join('');\n  }\n  function fmtMoney(c){return '$'+(c/100).toFixed(2);}\n  function fetchCart(){return fetch('/cart.js').then(function(r){return r.json();}).then(renderCart);}\n  window.mtCartOpen=function(){\n    document.getElementById('mt-cd').classList.add('open');\n    document.getElementById('mt-ov').classList.add('open');\n    fetchCart();\n  };\n  window.mtCartClose=function(){\n    document.getElementById('mt-cd').classList.remove('open');\n    document.getElementById('mt-ov').classList.remove('open');\n  };\n  window.mtCdQty=function(vid,cur,d){\n    fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},\n      body:JSON.stringify({id:vid,quantity:Math.max(0,cur+d)})})\n    .then(function(r){return r.json();}).then(renderCart);\n  };\n  var form=document.getElementById('mt-form');\n  if(form) form.addEventListener('submit',function(e){\n    e.preventDefault();\n    var sel=document.getElementById('mt-sel');\n    var qty=document.getElementById('mt-qty');\n    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},\n      body:JSON.stringify({id:sel?sel.value:null,quantity:qty?parseInt(qty.value)||1:1})})\n    .then(function(r){return r.json();})\n    .then(function(){ mtCartOpen(); });\n  });\n})();\n</script>\n</div>",
        "add_vertical_spacing": false,
        "background_type": "full_width",
        "background": "rgba(0,0,0,0)",
